                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource MutedLabel}"
                                                           Text="{DynamicResource StateDirectory}" />
