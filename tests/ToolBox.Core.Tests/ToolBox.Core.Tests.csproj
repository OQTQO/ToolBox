<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>ToolBox.Core.Tests</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolBox.Core\ToolBox.Core.csproj" />
    <ProjectReference Include="..\..\src\ToolBox.PluginSdk\ToolBox.PluginSdk.csproj" />
    <ProjectReference Include="..\Fixtures\HappyPathPlugin\HappyPathPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\CrashPlugin\CrashPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\HangPlugin\HangPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\UnloadLeakPlugin\UnloadLeakPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\WorkerChildProcessPlugin\WorkerChildProcessPlugin.csproj" />
    <ProjectReference Include="..\Fixtures\ProtocolMismatchWorker\ProtocolMismatchWorker.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\ToolBox.PluginWorker\ToolBox.PluginWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Fixtures\HappyPathPlugin\manifest.json"
          Link="HappyPathPlugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\WorkerChildProcessPlugin\manifest.json"
          Link="WorkerChildProcessPlugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\CrashPlugin\manifest.json"
          Link="CrashPlugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\HangPlugin\manifest.json"
          Link="HangPlugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Fixtures\UnloadLeakPlugin\manifest.json"
          Link="UnloadLeakPlugin.manifest.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginWorkerRuntime" AfterTargets="Build">
    <PropertyGroup>
      <LowercaseConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</LowercaseConfiguration>
      <PluginWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(MSBuildProjectDirectory)\..\..\src\ToolBox.PluginWorker\bin\$(Configuration)\net10.0</PluginWorkerBuildDirectory>
      <PluginWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(ArtifactsPath)\$(ArtifactsBinOutputName)\ToolBox.PluginWorker\$(LowercaseConfiguration)</PluginWorkerBuildDirectory>
    </PropertyGroup>

    <ItemGroup>
      <PluginWorkerRuntimeFiles Include="$(PluginWorkerBuildDirectory)\ToolBox.PluginWorker.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginWorkerRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPhase5Fixtures" AfterTargets="Build">
    <PropertyGroup>
      <LowercaseConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</LowercaseConfiguration>
      <FixtureBinRoot Condition="'$(UseArtifactsOutput)' != 'true'">$(MSBuildProjectDirectory)\..\Fixtures</FixtureBinRoot>
      <FixtureBinRoot Condition="'$(UseArtifactsOutput)' == 'true'">$(ArtifactsPath)\$(ArtifactsBinOutputName)</FixtureBinRoot>
      <WorkerChildFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(FixtureBinRoot)\WorkerChildProcessPlugin\bin\$(Configuration)\net10.0</WorkerChildFixtureBuildDirectory>
      <WorkerChildFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(FixtureBinRoot)\WorkerChildProcessPlugin\$(LowercaseConfiguration)</WorkerChildFixtureBuildDirectory>
      <ProtocolMismatchWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(FixtureBinRoot)\ProtocolMismatchWorker\bin\$(Configuration)\net10.0</ProtocolMismatchWorkerBuildDirectory>
      <ProtocolMismatchWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(FixtureBinRoot)\ProtocolMismatchWorker\$(LowercaseConfiguration)</ProtocolMismatchWorkerBuildDirectory>
      <CrashFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(FixtureBinRoot)\CrashPlugin\bin\$(Configuration)\net10.0</CrashFixtureBuildDirectory>
      <CrashFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(FixtureBinRoot)\CrashPlugin\$(LowercaseConfiguration)</CrashFixtureBuildDirectory>
      <HangFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(FixtureBinRoot)\HangPlugin\bin\$(Configuration)\net10.0</HangFixtureBuildDirectory>
      <HangFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(FixtureBinRoot)\HangPlugin\$(LowercaseConfiguration)</HangFixtureBuildDirectory>
      <UnloadLeakFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(FixtureBinRoot)\UnloadLeakPlugin\bin\$(Configuration)\net10.0</UnloadLeakFixtureBuildDirectory>
      <UnloadLeakFixtureBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(FixtureBinRoot)\UnloadLeakPlugin\$(LowercaseConfiguration)</UnloadLeakFixtureBuildDirectory>
    </PropertyGroup>

    <ItemGroup>
      <WorkerChildFixtureRuntimeFiles Include="$(WorkerChildFixtureBuildDirectory)\WorkerChildProcessPlugin.*" />
      <ProtocolMismatchWorkerRuntimeFiles Include="$(ProtocolMismatchWorkerBuildDirectory)\ProtocolMismatchWorker.*" />
      <CrashFixtureRuntimeFiles Include="$(CrashFixtureBuildDirectory)\CrashPlugin.*" />
      <HangFixtureRuntimeFiles Include="$(HangFixtureBuildDirectory)\HangPlugin.*" />
      <UnloadLeakFixtureRuntimeFiles Include="$(UnloadLeakFixtureBuildDirectory)\UnloadLeakPlugin.*" />
    </ItemGroup>

    <Copy SourceFiles="@(WorkerChildFixtureRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProtocolMismatchWorkerRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CrashFixtureRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(HangFixtureRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(UnloadLeakFixtureRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
