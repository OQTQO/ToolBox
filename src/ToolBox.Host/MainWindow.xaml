                                                        Click="OnSetChineseClick"
                                                        Style="{StaticResource ChoiceButtonStyle}" />
                                                <Button Margin="8,0,0,0"
                                                         Tag="english"
                                                         Content="English"
                                                         AutomationProperties.Name="English"
                                                         Click="OnSetEnglishClick"
                                                         Style="{StaticResource ChoiceButtonStyle}" />
