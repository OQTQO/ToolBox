<UserControl x:Class="ToolBox.Host.KeyboardTestWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <ScrollViewer Padding="42,34,34,50"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000">
            <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PluginWorkspace}" />
            <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource KeyboardMouse}" />
            <TextBlock Margin="0,8,0,0" MaxWidth="720" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource KeyboardPageDescriptionRefined}" TextWrapping="Wrap" />

            <Border Margin="0,24,0,0" Padding="22" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding StatusLabel}" /></StackPanel>
                        <TextBlock Margin="17,7,0,0" MaxWidth="650" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusDescription}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding ToggleLabel}" IsEnabled="{Binding IsToggleEnabled}" Click="OnToggleClick" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,6,0" Padding="22" MinHeight="230" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Focusable="True" KeyDown="OnSurfaceKeyDown" KeyUp="OnSurfaceKeyUp" MouseDown="OnSurfaceMouseDown" MouseUp="OnSurfaceMouseUp">
                    <StackPanel><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource InputSurface}" /><TextBlock Margin="0,14,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Text="{Binding LastInputLabel}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource InputSurfaceDescription}" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <Border Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource KeyEvents}" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding KeyEventCountLabel}" /></StackPanel></Border>
                    <Border Margin="0,12,0,0" Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource MouseEvents}" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding MouseEventCountLabel}" /></StackPanel></Border>
                </StackPanel>
            </Grid>

            <Border Margin="0,12,0,0" Padding="19" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox Grid.Column="0" VerticalAlignment="Center" Content="{DynamicResource CountKeyUp}" IsChecked="{Binding IncludeKeyUpEvents}" IsEnabled="{Binding IsSettingsEnabled}" /><CheckBox Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Content="{DynamicResource CountMouse}" IsChecked="{Binding IncludeMouseEvents}" IsEnabled="{Binding IsSettingsEnabled}" /><Button Grid.Column="2" Content="{DynamicResource ApplySettings}" IsEnabled="{Binding IsSettingsEnabled}" Click="OnApplySettingsClick" Style="{StaticResource QuietButtonStyle}" /></Grid></Border>
            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource RedBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
