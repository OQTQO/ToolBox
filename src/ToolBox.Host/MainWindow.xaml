<Window x:Class="ToolBox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ToolBox.Host"
        Title="{Binding TitleBarCenterText}"
        Icon="/ToolBox.Host;component/Assets/ToolBox.ico"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource CanvasBrush}"
        Loaded="OnWindowLoaded"
        Unloaded="OnWindowUnloaded"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <DataTemplate x:Key="PluginCardTemplate">
            <Border Padding="12"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnPluginCardMouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource SurfaceBorderStyle}">
                        <Setter Property="MinHeight" Value="152" />
                        <Setter Property="Margin" Value="0,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAttention}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34"
                                Height="34"
                                BorderBrush="{DynamicResource TextBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SmallControlCornerRadius}">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Black"
                                       FontSize="9"
                                       Text="{Binding IconLabel}" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="13"
                                       FontWeight="Bold"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="10"
                                       Style="{StaticResource MutedLabel}"
                                       Text="{Binding Publisher}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2"
                                Tag="{Binding}"
                                Click="OnPluginMoreClick"
                                Style="{StaticResource IconButtonStyle}"
                                AutomationProperties.Name="{DynamicResource More}"
                                ToolTip="{DynamicResource More}">
                            <TextBlock Text="⋯" />
                        </Button>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="7"
                                Height="7"
                                VerticalAlignment="Center"
                                Background="{Binding StatusAccentBrush}"
                                CornerRadius="{DynamicResource DotCornerRadius}" />
                        <TextBlock Grid.Column="1"
                                   Margin="7,0,0,0"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Text="{Binding LifecycleStateLabel}" />
                        <TextBlock Grid.Column="2"
                                   Foreground="{DynamicResource FaintTextBrush}"
                                   FontSize="10"
                                   Text="{Binding OpenedStateLabel}" />
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,7,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MutedLabel}"
                                       Text="{DynamicResource InstalledVersionLabel}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Text="{Binding InstalledVersion}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource MutedLabel}"
                                       Text="{DynamicResource RuntimeModeLabel}" />
                            <TextBlock Margin="0,3,0,0"
                                       FontSize="11"
                                       Text="{Binding RuntimeDescription}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   FontSize="11"
                                   Text="{Binding ErrorMessage}"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="11,6"
                                Content="{Binding RuntimeActionLabel}"
                                IsEnabled="{Binding IsRuntimeActionEnabled}"
                                Tag="{Binding}"
                                Click="OnWorkspaceRuntimeToggleClick"
                                Style="{StaticResource QuietButtonStyle}" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="11,6"
                                Content="{DynamicResource OpenDetails}"
                                Tag="{Binding}"
                                Click="OnPluginDetailsClick"
                                Style="{StaticResource QuietButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="OverviewPluginTemplate">
            <Border Margin="0,0,0,8"
                    Padding="10"
                    Style="{StaticResource SoftSurfaceBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34"
                            Height="34"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource SmallControlCornerRadius}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Black"
                                   Text="{Binding IconLabel}" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Margin="10,0,10,0"
                                VerticalAlignment="Center">
                        <TextBlock FontSize="13"
                                   FontWeight="Bold"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedLabel}"
                                   Text="{Binding InstalledVersion}" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Margin="0,0,12,0"
                            Padding="8,4"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource StatusCornerRadius}"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="10"
                                   FontWeight="Bold"
                                   Text="{Binding LifecycleStateLabel}" />
                    </Border>
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Padding="10,6"
                                Content="{Binding RuntimeActionLabel}"
                                IsEnabled="{Binding IsRuntimeActionEnabled}"
                                Tag="{Binding}"
                                Click="OnWorkspaceRuntimeToggleClick"
                                Style="{StaticResource QuietButtonStyle}" />
                        <Button Margin="6,0,0,0"
                                Padding="10,6"
                                Content="{DynamicResource ViewDetails}"
                                Tag="{Binding}"
                                Click="OnPluginDetailsClick"
                                Style="{StaticResource QuietButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EventRowTemplate">
            <Border Margin="0,0,0,8"
                    Padding="0,0,0,8"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="66" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding TimestampText}" />
                    <TextBlock Grid.Column="1"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="10"
                               FontWeight="Bold"
                               Text="{Binding Module}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               FontSize="12"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginValueTemplate">
            <Border Margin="0,0,8,8"
                    Padding="12"
                    Style="{StaticResource SoftSurfaceBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedLabel}"
                               Text="{Binding Label}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="{Binding Value}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginActionTemplate">
            <Button Margin="0,0,8,8"
                    Padding="14,10"
                    HorizontalContentAlignment="Left"
                    Content="{Binding Label}"
                    IsEnabled="{Binding IsEnabled}"
                    Click="OnPluginUiActionClick"
                    Style="{StaticResource QuietButtonStyle}"
                    ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementValueTemplate">
            <Border Margin="0,0,0,8"
                    Padding="12"
                    Style="{StaticResource SoftSurfaceBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource MutedLabel}"
                               Text="{Binding DisplayLabel}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="{Binding Value}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementActionTemplate">
            <Button Margin="0,0,8,8"
                    MinWidth="110"
                    MinHeight="36"
                    HorizontalAlignment="Left"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding IsEnabled}"
                    Click="OnPluginUiElementActionClick"
                    Style="{StaticResource PluginUiButtonStyle}"
                    ToolTip="{Binding AccessibleName}"
                    AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                               Text="{Binding DisplayIcon}"
                               Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                               Text="{Binding DisplayLabel}"
                               TextWrapping="NoWrap"
                               Visibility="{Binding HasVisibleText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiOptionTemplate">
            <TextBlock Text="{Binding Label}"
                       Foreground="{DynamicResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>

        <HierarchicalDataTemplate x:Key="PluginUiMenuItemTemplate"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="0,0,6,0"
                           Text="{Binding DisplayIcon}"
                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding DisplayLabel}" />
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="PluginUiMenuItemStyle" TargetType="{x:Type MenuItem}">
            <EventSetter Event="Click" Handler="OnPluginUiMenuItemClick" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
            <Setter Property="ToolTip" Value="{Binding DisplayLabel}" />
        </Style>

        <DataTemplate x:Key="PluginUiElementMenuTemplate">
            <Menu Margin="0,0,0,8"
                  IsEnabled="{Binding IsEnabled}">
                <MenuItem Header="{Binding DisplayLabel}"
                          ItemsSource="{Binding MenuItems}"
                          ItemTemplate="{StaticResource PluginUiMenuItemTemplate}"
                          ItemContainerStyle="{StaticResource PluginUiMenuItemStyle}"
                          ToolTip="{Binding Description}">
                    <MenuItem.Icon>
                        <TextBlock Text="{Binding DisplayIcon}"
                                   Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </MenuItem.Icon>
                </MenuItem>
            </Menu>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementSelectTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                           Text="{Binding DisplayLabel}" />
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ComboBox Margin="0,8,0,0"
                          ItemsSource="{Binding Options}"
                          ItemTemplate="{StaticResource PluginUiOptionTemplate}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource PluginUiComboBoxStyle}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementMultiSelectTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                           Text="{Binding DisplayLabel}" />
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl Margin="0,7,0,0"
                              ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Margin="0,1,0,1"
                                      Content="{Binding Label}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      IsEnabled="{Binding IsEnabled}"
                                      Style="{StaticResource PluginUiCheckBoxStyle}"
                                      ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementToggleTemplate">
            <CheckBox Margin="0,0,0,12"
                      Content="{Binding DisplayLabel}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding IsEnabled}"
                      Style="{StaticResource PluginUiCheckBoxStyle}"
                      ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementCheckBoxTemplate">
            <CheckBox Margin="0,0,0,12"
                      Content="{Binding DisplayLabel}"
                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                      IsEnabled="{Binding IsEnabled}"
                      Style="{StaticResource PluginUiCheckBoxStyle}"
                      ToolTip="{Binding Description}" />
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementRadioGroupTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                           Text="{Binding DisplayLabel}" />
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ItemsControl Margin="0,7,0,0"
                              ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Margin="0,1,0,1"
                                         GroupName="{Binding GroupName}"
                                         Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         IsEnabled="{Binding IsEnabled}"
                                         Style="{StaticResource PluginUiRadioButtonStyle}"
                                         ToolTip="{Binding Description}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementTextBoxTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                           Text="{Binding DisplayLabel}" />
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Margin="0,8,0,0"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding Description}"
                         LostFocus="OnPluginUiTextBoxLostFocus"
                         KeyDown="OnPluginUiTextBoxKeyDown" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementNumberBoxTemplate">
            <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                           Text="{Binding DisplayLabel}" />
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBox Margin="0,8,0,0"
                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                          IsEnabled="{Binding IsEnabled}"
                          ToolTip="{Binding Description}"
                         LostFocus="OnPluginUiTextBoxLostFocus"
                         KeyDown="OnPluginUiTextBoxKeyDown" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PluginUiElementSliderTemplate">
            <StackPanel Margin="0,0,0,14">
                    <DockPanel>
                    <TextBlock Style="{StaticResource PluginUiFieldLabelStyle}"
                               Text="{Binding DisplayLabel}" />
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <TextBlock Foreground="{DynamicResource TextBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Text="{Binding NumericValue, StringFormat={}{0:0.##}}" />
                        <TextBlock Margin="4,0,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11"
                                   Text="{Binding Unit}" />
                    </StackPanel>
                </DockPanel>
                <TextBlock Style="{StaticResource PluginUiFieldDescriptionStyle}"
                           Text="{Binding Description}"
                           Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Slider Margin="0,6,0,0"
                        Minimum="{Binding Minimum}"
                        Maximum="{Binding Maximum}"
                        TickFrequency="{Binding Step}"
                        IsSnapToTickEnabled="True"
                        Value="{Binding NumericValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{Binding IsEnabled}"
                        Style="{StaticResource PluginUiSliderStyle}"
                        ToolTip="{Binding Description}" />
            </StackPanel>
        </DataTemplate>

        <local:PluginUiElementTemplateSelector x:Key="PluginUiElementTemplateSelector"
                                               ValueTemplate="{StaticResource PluginUiElementValueTemplate}"
                                               ActionTemplate="{StaticResource PluginUiElementActionTemplate}"
                                               MenuTemplate="{StaticResource PluginUiElementMenuTemplate}"
                                               SelectControlTemplate="{StaticResource PluginUiElementSelectTemplate}"
                                               MultiSelectTemplate="{StaticResource PluginUiElementMultiSelectTemplate}"
                                               ToggleTemplate="{StaticResource PluginUiElementToggleTemplate}"
                                               CheckBoxTemplate="{StaticResource PluginUiElementCheckBoxTemplate}"
                                               RadioGroupTemplate="{StaticResource PluginUiElementRadioGroupTemplate}"
                                               TextBoxTemplate="{StaticResource PluginUiElementTextBoxTemplate}"
                                               NumberBoxTemplate="{StaticResource PluginUiElementNumberBoxTemplate}"
                                               SliderTemplate="{StaticResource PluginUiElementSliderTemplate}" />

        <DataTemplate x:Key="PluginUiElementItemTemplate">
            <StackPanel>
                <Border Margin="0,2,0,11"
                        Padding="0,0,0,8"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Visibility="{Binding ShowGroupHeader, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DockPanel>
                        <Border Width="4"
                                Height="16"
                                Margin="0,0,8,0"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Text="{Binding Group}" />
                    </DockPanel>
                </Border>
                <ContentControl Content="{Binding}"
                                ContentTemplateSelector="{StaticResource PluginUiElementTemplateSelector}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="WindowContent"
          Background="{DynamicResource CanvasBrush}"
          SnapsToDevicePixels="True">
        <Grid>
            <Grid Background="{DynamicResource CanvasBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="176" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource RailBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,1,0">
                    <DockPanel Margin="14,24,14,20">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Margin="12,0,0,10"
                                       Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Text="{DynamicResource NavigationLabel}" />
                            <Button Tag="overview"
                                    Click="OnOverviewNavigationClick"
                                    Content="{DynamicResource Overview}"
                                    AutomationProperties.Name="{DynamicResource Overview}"
                                    Style="{StaticResource SidebarNavigationButtonStyle}" />
                            <Button Margin="0,4,0,0"
                                    Tag="plugins"
                                    Click="OnPluginsNavigationClick"
                                    Content="{DynamicResource NavPlugins}"
                                    AutomationProperties.Name="{DynamicResource NavPlugins}"
                                    Style="{StaticResource SidebarNavigationButtonStyle}" />
                            <Button Margin="0,4,0,0"
                                    Tag="activity"
                                    Click="OnActivityNavigationClick"
                                    Content="{DynamicResource NavActivity}"
                                    AutomationProperties.Name="{DynamicResource NavActivity}"
                                    Style="{StaticResource SidebarNavigationButtonStyle}" />
                            <Button Margin="0,4,0,0"
                                    Tag="settings"
                                    Click="OnSettingsNavigationClick"
                                    Content="{DynamicResource Settings}"
                                    AutomationProperties.Name="{DynamicResource Settings}"
                                    Style="{StaticResource SidebarNavigationButtonStyle}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="PageScrollViewer"
                              Grid.Column="1"
                              Padding="0,0,0,12"
                              HorizontalContentAlignment="Stretch"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="PageHost"
                          MaxWidth="1280"
                          Margin="32,24,32,28"
                          HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,22">
                            <StackPanel>
                                <TextBlock Style="{StaticResource PageTitleText}"
                                           Text="{Binding PageTitle}"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Left"
                                           TextWrapping="Wrap" />
                                <TextBlock MaxWidth="620"
                                           Margin="0,8,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="13"
                                           LineHeight="19"
                                           Text="{Binding PageDescription}"
                                           TextAlignment="Left"
                                           HorizontalAlignment="Left"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid x:Name="OverviewPanel"
                                  Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <UniformGrid Grid.Row="0"
                                             Columns="3"
                                             Margin="0,0,0,18">
                                    <Border Margin="0,0,8,0"
                                            Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedLabel}"
                                                       Text="{DynamicResource InstalledTools}" />
                                            <StackPanel Margin="0,9,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Text="{Binding InstalledPluginCount}" />
                                                <TextBlock Margin="7,14,0,0"
                                                           Style="{StaticResource MutedLabel}"
                                                           Text="{DynamicResource ToolsUnit}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="4,0,4,0"
                                            Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedLabel}"
                                                       Text="{DynamicResource RunningTools}" />
                                            <StackPanel Margin="0,9,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Text="{Binding RunningPluginCount}" />
                                                <TextBlock Margin="7,14,0,0"
                                                           Style="{StaticResource MutedLabel}"
                                                           Text="{DynamicResource ToolsUnit}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="8,0,0,0"
                                            Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MutedLabel}"
                                                       Text="{DynamicResource NeedsAttention}" />
                                            <StackPanel Margin="0,9,0,0"
                                                        Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="32"
                                                           FontWeight="Bold"
                                                           Text="{Binding AttentionPluginCount}" />
                                                <TextBlock Margin="7,14,0,0"
                                                           Style="{StaticResource MutedLabel}"
                                                           Text="{DynamicResource ItemsUnit}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1"
                                        Padding="18"
                                        Style="{StaticResource SurfaceBorderStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
