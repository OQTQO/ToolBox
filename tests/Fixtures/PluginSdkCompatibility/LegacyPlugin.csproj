<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LegacyPlugin</RootNamespace>
    <AssemblyName>LegacyPlugin</AssemblyName>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <Version>0.1.0</Version>
    <LegacyPluginSdkProject>$(MSBuildProjectDirectory)\LegacyPluginSdk\LegacyPluginSdk.csproj</LegacyPluginSdkProject>
    <LegacyPluginSdkAssembly>$(MSBuildProjectDirectory)\LegacyPluginSdk\bin\$(Configuration)\net8.0\ToolBox.PluginSdk.dll</LegacyPluginSdkAssembly>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="LegacyPluginSdk\**\*.cs" />
    <None Remove="LegacyPluginSdk\**\*.cs" />
    <Reference Include="ToolBox.PluginSdk">
      <HintPath>$(LegacyPluginSdkAssembly)</HintPath>
      <Private>false</Private>
    </Reference>
    <ProjectReference Include="LegacyPluginSdk\LegacyPluginSdk.csproj"
                      ReferenceOutputAssembly="false"
                      BuildReference="false" />
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildLegacyPluginSdk" BeforeTargets="ResolveAssemblyReferences">
    <MSBuild Projects="$(LegacyPluginSdkProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="Version;VersionPrefix;VersionSuffix;PackageVersion;AssemblyVersion;FileVersion" />
  </Target>
</Project>
