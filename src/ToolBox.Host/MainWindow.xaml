                                                    ValueChanged="OnBackgroundBrightnessChanged"
                                                            PreviewMouseUp="OnSettingsSliderCommit"
                                                            KeyUp="OnSettingsSliderKeyUp" />
                                                </StackPanel>
                                                <StackPanel Width="220"
                                                            Margin="28,0,0,0">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource CornerRadius}" />
                                                    <Slider Margin="0,8,0,0"
                                                             Minimum="12"
                                                             Maximum="20"
                                                            Value="{Binding CornerRadius, Mode=OneWay}"
                                                            AutomationProperties.Name="{DynamicResource CornerRadius}"
                                                            ValueChanged="OnCornerRadiusChanged"
                                                            PreviewMouseUp="OnSettingsSliderCommit"
                                                            KeyUp="OnSettingsSliderKeyUp" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Left"
                                                    Margin="0,21,0,0"
                                                    Content="{DynamicResource RestoreDefaults}"
                                                    Click="OnRestoreAppearanceClick"
                                                    Style="{StaticResource QuietButtonStyle}" />
                                        </StackPanel>
                                    </Border>

                            <Border Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}"
                                            Visibility="{Binding IsPluginSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="{DynamicResource PluginManagement}" />
                                            <TextBlock Margin="0,8,0,20"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Text="{DynamicResource PluginSettingsDescription}"
                                                       TextWrapping="Wrap" />
                                             <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource ConfirmEnable}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource ConfirmEnableDescription}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1"
                                                              Tag="enable"
                                                              IsChecked="{Binding ConfirmEnable, Mode=OneWay}"
                                                              AutomationProperties.Name="{DynamicResource ConfirmEnable}"
                                                              Click="OnPluginOptionToggleClick"
                                                              Style="{StaticResource SwitchStyle}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,16">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource ConfirmUninstall}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource ConfirmUninstallDescription}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1"
                                                              Tag="uninstall"
                                                              IsChecked="{Binding ConfirmUninstall, Mode=OneWay}"
                                                              AutomationProperties.Name="{DynamicResource ConfirmUninstall}"
                                                              Click="OnPluginOptionToggleClick"
                                                              Style="{StaticResource SwitchStyle}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource ShowDiagnostics}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource ShowDiagnosticsDescription}" />
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1"
                                                              Tag="diagnostics"
                                                              IsChecked="{Binding ShowDiagnostics, Mode=OneWay}"
                                                              AutomationProperties.Name="{DynamicResource ShowDiagnostics}"
                                                              Click="OnPluginOptionToggleClick"
                                                              Style="{StaticResource SwitchStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}"
                                            Visibility="{Binding IsRuntimeSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="{DynamicResource Runtime}" />
                                            <TextBlock Margin="0,8,0,20"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Text="{DynamicResource RuntimeSettingsDescription}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock FontSize="12"
                                                       FontWeight="Bold"
                                                       Text="{DynamicResource CloseBehaviorTitle}" />
                                            <TextBlock Margin="0,4,0,11"
                                                       Style="{StaticResource MutedLabel}"
