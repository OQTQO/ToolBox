                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,0,12"
                                                             Stretch="Uniform">
                                                        <Canvas Width="64" Height="64">
                                                            <Path Data="M 10,27 H 54 V 52 H 10 Z M 22,27 V 16 H 42 V 27 M 10,37 H 54"
                                                                  Stroke="{DynamicResource TextBrush}"
                                                                  StrokeThickness="5"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                            <Path Data="M 20,44 H 28 M 36,44 H 44"
                                                                  Stroke="{DynamicResource TextBrush}"
                                                                  StrokeThickness="4"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </DockPanel>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Padding="18"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    CornerRadius="{DynamicResource PanelCornerRadius}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionTitleText}"
                                                               Text="{DynamicResource AboutToolBox}" />
                                                    <TextBlock Margin="0,8,0,0"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="12"
                                                               LineHeight="18"
                                                               Text="{DynamicResource AboutDescription}"
                                                               TextWrapping="Wrap" />
                                                    <Grid Margin="0,22,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource MutedLabel}"
                                                                   Text="{DynamicResource CurrentVersion}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding HostVersion}" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource MutedLabel}"
                                                                   Text="{DynamicResource PluginApi}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="1.x" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="130" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource MutedLabel}"
                                                                   Text="{DynamicResource UiProtocol}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="Manifest v2" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="PluginDetailsOverlay"
                      Grid.Column="1"
                      Panel.ZIndex="5"
                      Background="{DynamicResource ScrimBrush}"
                      MouseLeftButtonDown="OnPluginDetailsOverlayMouseLeftButtonDown"
                      Visibility="Collapsed">
                    <Border x:Name="PluginDetailsCard"
                            Width="520"
                            HorizontalAlignment="Right"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineStrongBrush}"
                            BorderThickness="2,0,0,0"
                            RenderTransformOrigin="1,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PluginDetailsTranslate" X="520" />
                        </Border.RenderTransform>
                        <Grid DataContext="{Binding SelectedPluginWorkspace}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Padding="20,18"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Text="{DynamicResource PluginWorkspace}" />
                                        <TextBlock Margin="0,7,0,0"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="34"
                                                   FontWeight="Black"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding Publisher}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                     <Button x:Name="PluginDetailsCloseButton"
                                             Grid.Column="1"
                                             Click="OnClosePluginDetailsClick"
                                              AutomationProperties.Name="{DynamicResource Close}"
                                              Style="{StaticResource IconButtonStyle}"
                                              ToolTip="{DynamicResource Close}">
                                         <Path Data="M 3.25,3.25 L 10.75,10.75 M 10.75,3.25 L 3.25,10.75"
                                               Stroke="{DynamicResource TextBrush}"
                                               StrokeThickness="1.5"
                                               StrokeStartLineCap="Square"
                                               StrokeEndLineCap="Square" />
                                     </Button>
                                </Grid>
                            </Border>
                            <ScrollViewer x:Name="PluginDetailsScroll"
                                          Grid.Row="1"
                                          Padding="20,18,20,24"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8"
                                                    Height="8"
                                                    Margin="0,2,0,0"
                                                    Background="{Binding StatusAccentBrush}"
                                                    CornerRadius="{DynamicResource DotCornerRadius}" />
                                            <TextBlock Margin="7,0,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Text="{Binding LifecycleStateLabel}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding RuntimeDescription}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,18,0,18">
                                        <Button Content="{Binding RuntimeActionLabel}"
                                                IsEnabled="{Binding IsRuntimeActionEnabled}"
                                                Click="OnWorkspaceRuntimeToggleClick"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <Button Margin="8,0,0,0"
                                                Content="{DynamicResource Uninstall}"
                                                IsEnabled="{Binding IsUninstallEnabled}"
                                                Click="OnWorkspaceUninstallClick"
                                                Style="{StaticResource QuietButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,16">
                                        <Button x:Name="PluginOverviewTab"
                                                Tag="overview"
                                                Content="{DynamicResource Overview}"
                                                Click="OnPluginDetailsTabClick"
                                                Style="{StaticResource TabButtonStyle}" />
                                        <Button x:Name="PluginOperationsTab"
                                                Margin="4,0,0,0"
                                                Tag="operations"
                                                Content="{DynamicResource PluginControls}"
                                                Click="OnPluginDetailsTabClick"
                                                Style="{StaticResource TabButtonStyle}" />
                                        <Button x:Name="PluginLogsTab"
                                                Margin="4,0,0,0"
                                                Tag="logs"
                                                Content="{DynamicResource NavActivity}"
                                                Click="OnPluginDetailsTabClick"
                                                Style="{StaticResource TabButtonStyle}" />
                                        <Button x:Name="PluginAboutTab"
                                                Margin="4,0,0,0"
                                                Tag="about"
                                                Content="{DynamicResource About}"
                                                Click="OnPluginDetailsTabClick"
                                                Style="{StaticResource TabButtonStyle}" />
                                    </StackPanel>

                                    <StackPanel x:Name="PluginOverviewPanel">
                                        <TextBlock Style="{StaticResource SectionTitleText}"
                                                   Text="{DynamicResource PluginStatus}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Text="{Binding StatusDescription}"
                                                   TextWrapping="Wrap" />
                                        <UniformGrid Margin="0,18,0,0"
                                                     Columns="2">
                                            <Border Margin="0,0,8,8"
                                                    Padding="12"
                                                    Style="{StaticResource SoftSurfaceBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource InstalledVersionLabel}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Text="{Binding InstalledVersion}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12"
                                                    Style="{StaticResource SoftSurfaceBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource RuntimeModeLabel}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Text="{Binding RuntimeMode}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,8,8"
                                                    Padding="12"
                                                    Style="{StaticResource SoftSurfaceBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource PluginIdLabel}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="11"
                                                               Text="{Binding PluginId}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <Border Margin="0,0,0,8"
                                                    Padding="12"
                                                    Style="{StaticResource SoftSurfaceBorderStyle}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource StatusOpened}" />
                                                    <TextBlock Margin="0,5,0,0"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Text="{Binding OpenedStateLabel}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                        <Border Margin="0,9,0,0"
                                                Padding="14"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                                       FontSize="11"
                                                       Text="{Binding ErrorMessage}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="PluginOperationsPanel"
                                                Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SectionTitleText}"
                                                   Text="{DynamicResource PluginControls}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Text="{Binding PluginUiStatusMessage}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasPluginUi, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="0,12,0,0"
                                                Padding="12"
                                                Style="{StaticResource SoftSurfaceBorderStyle}"
                                                Visibility="{Binding HasPluginUiStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               Text="{Binding PluginUiStatusKindLabel}" />
                                                    <Button DockPanel.Dock="Right"
                                                            Padding="9,5"
                                                            Content="{DynamicResource PluginCommandCancel}"
                                                            IsEnabled="{Binding IsPluginUiActionEnabled}"
                                                            Click="OnPluginUiProgressCancelClick"
                                                            Visibility="{Binding HasPluginUiProgressCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Style="{StaticResource QuietButtonStyle}" />
                                                </DockPanel>
                                                <TextBlock Margin="0,5,0,0"
                                                           FontSize="12"
                                                           Text="{Binding PluginUiStatusText}"
                                                           TextWrapping="Wrap" />
                                                <ProgressBar Margin="0,10,0,0"
                                                             Height="6"
                                                             Minimum="0"
                                                             Maximum="{Binding PluginUiProgressMaximum}"
                                                             Value="{Binding PluginUiProgressValue, Mode=OneWay}"
                                                             IsIndeterminate="{Binding IsPluginUiProgressIndeterminate}"
                                                             Visibility="{Binding HasPluginUiProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,15,0,0"
                                                Padding="14"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Visibility="{Binding HasPluginUiUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="Bold"
                                                           Text="{DynamicResource PluginNoControls}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{DynamicResource PluginNoControlsDescription}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,15,0,0"
                                                Padding="14"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Visibility="{Binding IsPluginUiDisabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="Bold"
                                                           Text="{DynamicResource PluginControlsDisabled}" />
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{DynamicResource PluginControlsDisabledDescription}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl Margin="0,15,0,0"
                                                      ItemsSource="{Binding UiValues}"
                                                      ItemTemplate="{StaticResource PluginValueTemplate}"
                                                      Visibility="{Binding HasUiValues, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <ItemsControl Margin="0,8,0,0"
                                                      ItemsSource="{Binding UiActions}"
                                                      ItemTemplate="{StaticResource PluginActionTemplate}"
                                                      Visibility="{Binding HasUiActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border x:Name="PluginInputSurfaceHost"
                                                Margin="0,15,0,0"
                                                Padding="15"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Focusable="True"
                                                PreviewKeyDown="OnPluginInputKeyDown"
                                                PreviewKeyUp="OnPluginInputKeyUp"
                                                PreviewMouseDown="OnPluginInputMouseDown"
                                                PreviewMouseUp="OnPluginInputMouseUp"
                                                Visibility="{Binding HasInputSurface, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock FontSize="13"
                                                           FontWeight="Bold"
                                                           Text="{Binding InputSurface.Label}" />
                                                <TextBlock Margin="0,5,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11"
                                                           Text="{Binding InputSurface.Description}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0,15,0,0"
                                                Padding="16,15,16,2"
                                                Style="{StaticResource SurfaceBorderStyle}"
                                                Visibility="{Binding HasUiElements, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding UiElements}"
                                                          ItemTemplate="{StaticResource PluginUiElementItemTemplate}" />
                                        </Border>
                                        <Border Margin="0,15,0,0"
                                                Padding="14"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Visibility="{Binding HasPluginUiError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Foreground="{DynamicResource ErrorBrush}"
                                                       FontSize="11"
                                                       Text="{Binding PluginUiErrorMessage}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <StackPanel x:Name="PluginLogsPanel"
                                                Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SectionTitleText}"
                                                   Text="{DynamicResource RecentActivity}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   Text="{DynamicResource PluginLogDescription}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl Margin="0,17,0,0"
                                                      ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.RecentEvents}"
                                                      ItemTemplate="{StaticResource EventRowTemplate}"
                                                      MaxHeight="280" />
                                    </StackPanel>

                                    <StackPanel x:Name="PluginAboutPanel"
                                                Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SectionTitleText}"
                                                   Text="{DynamicResource PluginHostBoundary}" />
                                        <TextBlock Margin="0,9,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   Text="{DynamicResource PluginHostBoundaryDescription}"
                                                   TextWrapping="Wrap" />
                                        <Border Margin="0,18,0,0"
                                                Padding="15"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource CurrentVersion}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding InstalledVersion}" />
                                                </Grid>
                                                <Grid Margin="0,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource PluginIdLabel}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding PluginId}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

        </Grid>
    </Grid>
</Window>
