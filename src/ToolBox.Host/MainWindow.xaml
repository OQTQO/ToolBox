                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource SectionTitleText}"
                                                           Text="{DynamicResource RecentActivity}" />
                                                <Button Grid.Column="1"
                                                        Content="{DynamicResource ViewAll}"
                                                        Click="OnActivityNavigationClick"
                                                        Style="{StaticResource QuietButtonStyle}"
                                                        Padding="11,6" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding OverviewEvents}"
                                                          ItemTemplate="{StaticResource EventRowTemplate}"
                                                          MaxHeight="140" />
                                            <Border Padding="10"
                                                    Background="{DynamicResource SurfaceRaisedBrush}"
                                                    CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                    Visibility="{Binding HasNoOverviewEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
