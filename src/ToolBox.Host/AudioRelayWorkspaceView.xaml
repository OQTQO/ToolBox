<UserControl x:Class="ToolBox.Host.AudioRelayWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <ScrollViewer Padding="42,34,34,50"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1000">
            <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PluginWorkspace}" />
            <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource PhoneAudioRelay}" />
            <TextBlock Margin="0,8,0,0" MaxWidth="720" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource AudioPageDescriptionRefined}" TextWrapping="Wrap" />

            <Border Margin="0,24,0,0" Padding="22" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding StatusLabel}" /></StackPanel><TextBlock Margin="17,7,0,0" MaxWidth="650" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusDescription}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding ToggleLabel}" IsEnabled="{Binding IsToggleEnabled}" Visibility="{Binding IsNormalToggleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnToggleClick" Style="{StaticResource AccentButtonStyle}" /><Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding RestartActionLabel}" IsEnabled="{Binding IsRestartActionEnabled}" Visibility="{Binding IsRestartActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnRestartClick" Style="{StaticResource AccentButtonStyle}" /></Grid></Border>

            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,6,0" Padding="22" Style="{StaticResource CardStyle}">
                    <StackPanel><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PairedPhones}" /><TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding DeviceCountLabel}" /><ComboBox Margin="0,17,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" Style="{StaticResource RelayComboBoxStyle}" /><StackPanel Margin="0,16,0,0" Orientation="Horizontal"><Button Content="{DynamicResource RefreshDevices}" IsEnabled="{Binding IsRefreshEnabled}" Click="OnRefreshClick" Style="{StaticResource QuietButtonStyle}" /><Button Margin="8,0,0,0" Content="{DynamicResource StartReceiving}" IsEnabled="{Binding IsConnectEnabled}" Click="OnConnectClick" Style="{StaticResource AccentButtonStyle}" /><Button Margin="8,0,0,0" Content="{DynamicResource StopReceiving}" IsEnabled="{Binding IsDisconnectEnabled}" Click="OnDisconnectClick" Style="{StaticResource QuietButtonStyle}" /></StackPanel></StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="6,0,0,0" Padding="20" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource RelayRoute}" /><TextBlock Margin="0,18,0,0" FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource SelectedPhone}" /><TextBlock Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding SelectedPhoneLabel}" TextWrapping="Wrap" /><Border Margin="0,13,0,13" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" /><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource RouteState}" /><TextBlock Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding RouteStateLabel}" /></StackPanel></Border>
            </Grid>
            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource RedBrush}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
