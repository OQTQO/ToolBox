                                                           FontSize="11"
                                                           Text="{DynamicResource NoRecentActivity}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                             <Grid x:Name="PluginsPanel"
                                   Visibility="{Binding IsPluginPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                 <Grid.RowDefinitions>
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                     <RowDefinition Height="Auto" />
                                 </Grid.RowDefinitions>
                                <Grid Grid.Row="0"
                                      Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox x:Name="PluginSearchBox"
                                                 MinHeight="34"
                                                 VerticalContentAlignment="Center"
                                                 Text="{Binding PluginSearchText, Mode=OneWay}"
                                                 TextChanged="OnPluginSearchTextChanged"
                                                 AutomationProperties.Name="{DynamicResource SearchPlugins}"
                                                 ToolTip="{DynamicResource SearchPlugins}" />
                                        <TextBlock x:Name="PluginSearchPlaceholder"
                                                   Margin="12,0,12,0"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource FaintTextBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Text="{DynamicResource SearchPlugins}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Margin="8,0,0,0">
                                        <Button Tag="all"
                                                Content="{DynamicResource AllPlugins}"
                                                Click="OnPluginFilterClick"
                                                Style="{StaticResource FilterButtonStyle}" />
                                        <Button Margin="4,0,0,0"
                                                Tag="running"
                                                Content="{DynamicResource RunningPlugins}"
                                                Click="OnPluginFilterClick"
                                                Style="{StaticResource FilterButtonStyle}" />
                                        <Button Margin="4,0,0,0"
                                                Tag="disabled"
                                                Content="{DynamicResource DisabledPlugins}"
                                                Click="OnPluginFilterClick"
                                                Style="{StaticResource FilterButtonStyle}" />
                                        <Button Margin="4,0,0,0"
                                                Tag="attention"
                                                Content="{DynamicResource AttentionPlugins}"
                                                Click="OnPluginFilterClick"
                                                Style="{StaticResource FilterButtonStyle}" />
                                        <Button Margin="8,0,0,0"
                                                Content="{Binding PluginSortLabel}"
                                                Click="OnPluginSortClick"
                                                AutomationProperties.Name="{DynamicResource SortBy}"
                                                Style="{StaticResource QuietButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Row="1"
                                        HorizontalAlignment="Right"
                                        Margin="0,0,0,12"
                                        Padding="13,7"
                                        Content="{DynamicResource InstallLocalPlugin}"
                                        Click="OnInstallPluginClick"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        AutomationProperties.Name="{DynamicResource InstallLocalPlugin}" />
                                <StackPanel Grid.Row="2">
                                    <ItemsControl ItemsSource="{Binding VisiblePluginWorkspaces}"
                                                  ItemTemplate="{StaticResource PluginCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <local:ResponsiveCardPanel ColumnGap="12"
                                                                            RowGap="12"
                                                                            MinColumnWidth="320" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Border Padding="16"
                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                            BorderBrush="{DynamicResource LineStrongBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource PanelCornerRadius}"
                                            Visibility="{Binding HasNoVisiblePlugins, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="18"
                                                       FontWeight="Black"
                                                       Text="{DynamicResource NoPluginsInstalled}" />
                                            <TextBlock MaxWidth="370"
                                                       Margin="0,8,0,0"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Text="{DynamicResource NoPluginsDescription}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid x:Name="ActivityPanel"
                                  Visibility="{Binding IsActivityPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width=".8*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Padding="16"
                                        Style="{StaticResource SurfaceBorderStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="{DynamicResource EventStreamTitle}" />
                                            <Button Grid.Column="1"
                                                    Content="{DynamicResource ClearEvents}"
                                                    Click="OnClearEventsClick"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Padding="11,6" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,13"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{DynamicResource LogsDescription}"
                                                   TextWrapping="Wrap" />
                                        <ItemsControl ItemsSource="{Binding RecentEvents}"
                                                      ItemTemplate="{StaticResource EventRowTemplate}" />
                                         <Border Padding="12"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                CornerRadius="{DynamicResource SmallControlCornerRadius}"
                                                Visibility="{Binding HasNoEvents, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="12"
                                                       Text="{DynamicResource NoRecentActivity}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2"
                                        Padding="16"
                                        Style="{StaticResource SurfaceBorderStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="{DynamicResource SystemStatus}" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Text="{Binding OverviewHealthStatusLabel}" />
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,10,0,0"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Text="{Binding OverviewHealthHeadline}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Row="2"
                                                   MaxWidth="340"
                                                   Margin="0,5,0,0"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   FontSize="11"
                                                   Text="{Binding OverviewHealthDescription}"
                                                   TextWrapping="Wrap" />
                                        <Grid Grid.Row="3"
                                              Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource MutedLabel}"
                                                       Text="{DynamicResource HostConnection}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Text="{Binding HeaderStatusLabel}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="SettingsPanel"
                                  Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Button Tag="appearance"
                                            Content="{DynamicResource Appearance}"
                                            AutomationProperties.Name="{DynamicResource Appearance}"
                                            Click="OnSettingsSectionClick"
                                            Style="{StaticResource SettingsSectionButtonStyle}" />
                                    <Button Margin="0,7,0,0"
                                            Tag="plugins"
                                            Content="{DynamicResource Plugins}"
                                            AutomationProperties.Name="{DynamicResource Plugins}"
                                            Click="OnSettingsSectionClick"
                                            Style="{StaticResource SettingsSectionButtonStyle}" />
                                    <Button Margin="0,7,0,0"
                                            Tag="runtime"
                                            Content="{DynamicResource Runtime}"
                                            AutomationProperties.Name="{DynamicResource Runtime}"
                                            Click="OnSettingsSectionClick"
                                            Style="{StaticResource SettingsSectionButtonStyle}" />
                                    <Button Margin="0,7,0,0"
                                            Tag="about"
                                            Content="{DynamicResource About}"
                                            AutomationProperties.Name="{DynamicResource About}"
                                            Click="OnSettingsSectionClick"
                                            Style="{StaticResource SettingsSectionButtonStyle}" />
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <Border Padding="18"
                                            Style="{StaticResource SurfaceBorderStyle}"
                                            Visibility="{Binding IsAppearanceSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionTitleText}"
                                                       Text="{DynamicResource WorkspaceCopyTitle}" />
                                             <TextBlock MaxWidth="620"
                                                        Margin="0,8,0,18"
                                                        Foreground="{DynamicResource MutedTextBrush}"
                                                        FontSize="12"
                                                        Text="{DynamicResource WorkspaceCopyDescription}"
                                                        TextWrapping="Wrap" />
                                             <StackPanel Margin="0,0,0,18">
                                                 <TextBlock FontSize="12"
                                                            FontWeight="Bold"
                                                            Text="{DynamicResource TitleBarCenterTextCustomLabel}" />
                                                 <TextBlock Margin="0,4,0,7"
                                                            Style="{StaticResource MutedLabel}"
                                                            Text="{DynamicResource TitleBarCenterTextCustomHint}" />
                                                 <TextBox Text="{Binding TitleBarCenterText, Mode=OneWay}"
                                                          TextChanged="OnTitleBarCenterTextChanged"
                                                          LostFocus="OnOverviewCopyLostFocus"
                                                          MaxLength="32" />
                                             </StackPanel>
                                             <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource OverviewTitleCustomLabel}" />
                                                    <TextBlock Margin="0,4,0,7"
                                                               Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource OverviewTitleCustomHint}" />
                                                    <TextBox Text="{Binding OverviewTitle, Mode=OneWay}"
                                                             TextChanged="OnOverviewTitleTextChanged"
                                                             LostFocus="OnOverviewCopyLostFocus"
                                                             MaxLength="28" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource OverviewHealthTitleCustomLabel}" />
                                                    <TextBlock Margin="0,4,0,7"
                                                               Style="{StaticResource MutedLabel}"
                                                               Text="{DynamicResource OverviewHealthTitleCustomHint}" />
                                                    <TextBox Text="{Binding OverviewHealthTitle, Mode=OneWay}"
