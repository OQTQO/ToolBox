                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource InstalledVersionLabel}" /><TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding SelectedPluginWorkspace.InstalledVersion}" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource RuntimeModeLabel}" /><TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding SelectedPluginWorkspace.RuntimeDescription}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource PluginIdLabel}" /><TextBlock Margin="0,4,0,0" FontFamily="{StaticResource UtilityFont}" FontSize="10" Text="{Binding SelectedPluginWorkspace.PluginId}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PluginOperationsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource PluginControls}" />
                        <Border Margin="0,10,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding SelectedPluginWorkspace.HasInputSurface, Converter={StaticResource BooleanToVisibilityConverter}}" Focusable="True" IsEnabled="{Binding SelectedPluginWorkspace.IsPluginInputEnabled}" KeyDown="OnPluginInputKeyDown" KeyUp="OnPluginInputKeyUp" MouseDown="OnPluginInputMouseDown" MouseUp="OnPluginInputMouseUp">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" Background="{DynamicResource AccentSoftBrush}" CornerRadius="9"><Path Width="15" Height="15" Data="{Binding SelectedPluginWorkspace.IconGeometry}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2" /></Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding SelectedPluginWorkspace.InputSurface.Label}" />
                                    <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedPluginWorkspace.InputSurface.Description}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource AccentBrush}" Text="{Binding SelectedPluginWorkspace.PluginUiStatusMessage}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Margin="0,12,0,0" Padding="15" Style="{StaticResource InnerSurfaceStyle}" Visibility="{Binding SelectedPluginWorkspace.HasPluginUi, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding SelectedPluginWorkspace.UiValues}" Visibility="{Binding SelectedPluginWorkspace.HasUiValues, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,8,8" Padding="10" MinWidth="128" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="9"><StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding Label}" /><TextBlock Margin="0,4,0,0" FontSize="13" FontWeight="SemiBold" Text="{Binding Value}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding SelectedPluginWorkspace.UiActions}" Visibility="{Binding SelectedPluginWorkspace.HasUiActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Margin="0,0,8,8" Content="{Binding Label}" IsEnabled="{Binding IsEnabled}" Click="OnPluginUiActionClick" Style="{StaticResource AccentButtonStyle}" ToolTip="{Binding Description}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="{Binding SelectedPluginWorkspace.PluginUiErrorMessage}" TextWrapping="Wrap" Visibility="{Binding SelectedPluginWorkspace.HasPluginUiError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding SelectedPluginWorkspace.IsPluginUiDisabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource PluginControlsDisabled}" /><TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource PluginControlsDisabledDescription}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding SelectedPluginWorkspace.HasPluginUiUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Text="{DynamicResource PluginNoControls}" /><TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource PluginNoControlsDescription}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Margin="0,12,0,0" Padding="15" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" CornerRadius="12" Visibility="{Binding SelectedPluginWorkspace.HasPluginUiError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Text="{DynamicResource PluginUiError}" /><TextBlock Margin="0,6,0,0" FontFamily="{StaticResource UtilityFont}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedPluginWorkspace.PluginUiErrorMessage}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PluginLogsPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource NavActivity}" />
                        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding RecentEvents}" ItemTemplate="{StaticResource EventRowTemplate}" />
                    </StackPanel>
                    <StackPanel x:Name="PluginAboutPanel" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource About}" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource PluginIdLabel}" /><TextBlock Grid.Column="1" FontFamily="{StaticResource UtilityFont}" FontSize="11" Text="{Binding SelectedPluginWorkspace.PluginId}" />
                            <TextBlock Grid.Row="1" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource RuntimeModeLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" FontSize="11" Text="{Binding SelectedPluginWorkspace.RuntimeDescription}" />
                            <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource CurrentVersion}" /><TextBlock Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" FontSize="11" Text="{Binding SelectedPluginWorkspace.InstalledVersion}" />
                            <TextBlock Grid.Row="3" Margin="0,12,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource PluginHostBoundary}" /><TextBlock Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" FontSize="11" Text="{DynamicResource RuntimeBoundary}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding SelectedPluginWorkspace.CardSizeLabel}" />
                <Button Grid.Column="1" Margin="10,0,0,0" Content="{Binding SelectedPluginWorkspace.RuntimeActionLabel}" IsEnabled="{Binding SelectedPluginWorkspace.IsRuntimeActionEnabled}" Tag="{Binding SelectedPluginWorkspace}" Click="OnWorkspaceRuntimeToggleClick" Style="{StaticResource QuietButtonStyle}" />
                <Button Grid.Column="2" Margin="10,0,0,0" Content="{DynamicResource Uninstall}" IsEnabled="{Binding SelectedPluginWorkspace.IsUninstallEnabled}" Tag="{Binding SelectedPluginWorkspace}" Click="OnWorkspaceUninstallClick" Style="{StaticResource DangerButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</Grid>
        </Grid>
    </Grid>
</Border>
</Window>
