<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RootNamespace>ToolBox.Host</RootNamespace>
    <AssemblyName>ToolBox.Host</AssemblyName>
    <Version>0.6.0</Version>
    <ApplicationIcon>Assets\ToolBox.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolBox.Core\ToolBox.Core.csproj" />
    <ProjectReference Include="..\ToolBox.PluginSdk\ToolBox.PluginSdk.csproj" />
    <ProjectReference Include="..\ToolBox.PluginWorker\ToolBox.PluginWorker.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ToolBox.ico" />
    <Resource Include="Assets\ToolBox.Tray.ico" />
    <Resource Include="Assets\ToolBox.svg" />
  </ItemGroup>

  <Target Name="CopyPluginWorkerRuntime" AfterTargets="Build">
    <PropertyGroup>
      <LowercaseConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</LowercaseConfiguration>
      <PluginWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' != 'true'">$(MSBuildProjectDirectory)\..\ToolBox.PluginWorker\bin\$(Configuration)\net10.0</PluginWorkerBuildDirectory>
      <PluginWorkerBuildDirectory Condition="'$(UseArtifactsOutput)' == 'true'">$(ArtifactsPath)\$(ArtifactsBinOutputName)\ToolBox.PluginWorker\$(LowercaseConfiguration)</PluginWorkerBuildDirectory>
    </PropertyGroup>

    <ItemGroup>
      <PluginWorkerRuntimeFiles Include="$(PluginWorkerBuildDirectory)\ToolBox.PluginWorker.*" />
    </ItemGroup>

    <Copy SourceFiles="@(PluginWorkerRuntimeFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
