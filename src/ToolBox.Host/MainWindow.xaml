<Window x:Class="ToolBox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1220"
        Height="780"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource CanvasBrush}"
        StateChanged="OnWindowStateChanged"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome"
                            CaptionHeight="0"
                            CornerRadius="10"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame"
            Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource LineStrongBrush}"
            ClipToBounds="True"
            Loaded="OnWindowFrameLoaded"
            SizeChanged="OnWindowFrameSizeChanged">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="#FBFCFE"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="141" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="15,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="25" Height="25">
                            <Border Background="{StaticResource BlueBrush}" CornerRadius="6" />
                            <Rectangle Width="15" Height="4" Margin="0,-6,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="White" RadiusX="1.5" RadiusY="1.5" />
                            <Rectangle Width="4" Height="12" Margin="0,5,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="White" RadiusX="1.5" RadiusY="1.5" />
                            <Ellipse Width="3" Height="3" Margin="0,0,11,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#B8D0FF" />
                            <Ellipse Width="3" Height="3" Margin="11,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Fill="#B8D0FF" />
                        </Grid>
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="ToolBox" />
                        <TextBlock Margin="9,0,0,0" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource HostShell}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button AutomationProperties.Name="{DynamicResource MinimizeWindow}"
                                Click="OnMinimizeClick"
                                Style="{StaticResource ChromeButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="10" Data="M 1,7.5 L 9,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                        <Button Click="OnMaximizeClick"
                                Style="{StaticResource MaximizeChromeButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Grid Width="11" Height="11">
                                <Path Data="M 1.5,1.5 L 9.5,1.5 L 9.5,9.5 L 1.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1">
                                    <Path.Style><Style TargetType="Path"><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                                <Path Data="M 1.5,3.5 L 7.5,3.5 L 7.5,9.5 L 1.5,9.5 Z M 3.5,3.5 L 3.5,1.5 L 9.5,1.5 L 9.5,7.5 L 7.5,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1">
                                    <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                        <Button AutomationProperties.Name="{DynamicResource CloseWindow}"
                                Click="OnCloseClick"
                                Style="{StaticResource CloseChromeButtonStyle}"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="10" Height="10" Data="M 1,1 L 9,9 M 9,1 L 1,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource RailBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="13,21,13,14">
                        <StackPanel Margin="10,0,10,15">
                            <TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource Workspace}" />
                            <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Text="{DynamicResource Host}" />
                        </StackPanel>

                        <Button Click="OnOverviewNavigationClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                                    <Style.Triggers><DataTrigger Binding="{Binding IsOverviewPage}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Width="16" Height="16" Data="M 2,10 L 8,10 L 8,2 L 2,2 Z M 12,16 L 18,16 L 18,8 L 12,8 Z M 2,16 L 8,16 L 8,14 L 2,14 Z M 12,4 L 18,4 L 18,2 L 12,2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource Overview}" /></Grid>
                        </Button>

                        <StackPanel Margin="0,15,0,0" Visibility="{Binding HasOpenedPlugins, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="10,0,0,6" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource OpenedPlugins}" />
                            <Button Click="OnKeyboardNavigationClick" Visibility="{Binding IsKeyboardOpened, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboardPage}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Path Width="17" Height="14" Data="M 1,3 L 19,3 L 19,15 L 1,15 Z M 5,7 L 5.1,7 M 8,7 L 8.1,7 M 11,7 L 11.1,7 M 14,7 L 14.1,7 M 6,11 L 14,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource KeyboardMouse}" /><Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding KeyboardTest.StatusAccentBrush}" /></Grid>
                            </Button>
                            <Button Click="OnAudioRelayNavigationClick" Visibility="{Binding IsAudioRelayOpened, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsAudioRelayPage}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Path Width="17" Height="17" Data="M 6,15 L 6,5 L 15,3 L 15,13 M 6,15 C 6,17 2,17 2,15 C 2,13 6,13 6,15 M 15,13 C 15,15 11,15 11,13 C 11,11 15,11 15,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource PhoneAudioRelay}" /><Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding AudioRelay.StatusAccentBrush}" /></Grid>
                            </Button>
                        </StackPanel>

                        <TextBlock Margin="10,19,0,6" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource Host}" />
                        <Button Click="OnSettingsNavigationClick">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsPage}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Width="17" Height="17" Data="M 10,6 A 4,4 0 1 0 10,14 A 4,4 0 1 0 10,6 M 10,1 L 11,4 M 10,16 L 10,19 M 1,10 L 4,10 M 16,10 L 19,10 M 3.5,3.5 L 5.5,5.5 M 14.5,14.5 L 16.5,16.5 M 16.5,3.5 L 14.5,5.5 M 5.5,14.5 L 3.5,16.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource Settings}" /></Grid>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="23,0,23,18">
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StatusLabel}" /><TextBlock Margin="5,0,0,0" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Text="· v" /><TextBlock FontSize="10" Foreground="{StaticResource FaintTextBrush}" Text="{Binding HostVersion}" /></StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1">
                <!-- Overview -->
                <ScrollViewer Padding="42,34,34,50" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource OverviewEyebrow}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource OverviewTitleRefined}" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="720" HorizontalAlignment="Left" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource OverviewDescriptionRefined}" TextWrapping="Wrap" />

                        <Border Margin="0,25,0,0" Padding="27" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="#CAD8EC" BorderThickness="1" CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Text="{DynamicResource AllComponentsOperational}" /></StackPanel>
                                    <TextBlock Margin="0,24,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="25" FontWeight="SemiBold"><Run Text="{Binding OpenedPluginCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource ToolsOpened}" /></TextBlock>
                                    <TextBlock Margin="0,7,0,0" MaxWidth="560" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource OverviewStatusRefined}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Viewbox Grid.Column="1" Height="85" Margin="15,0,0,0" VerticalAlignment="Center" Opacity="0.55">
                                    <Path Data="M 0,36 L 32,36 L 42,17 L 52,57 L 64,36 L 95,36 L 103,27 L 112,48 L 124,36 L 158,36 L 169,9 L 180,65 L 193,36 L 232,36 L 242,27 L 251,48 L 262,36" Stroke="{StaticResource BlueBrush}" StrokeThickness="2" Fill="Transparent" />
                                </Viewbox>
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,8,0" Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource Installed}" /><TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding InstalledPluginCount}" /></StackPanel></Border>
                            <Border Grid.Column="1" Margin="4,0" Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource Opened}" /><TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding OpenedPluginCount}" /></StackPanel></Border>
                            <Border Grid.Column="2" Margin="8,0,0,0" Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource HostVersionLabel}" /><TextBlock Margin="0,7,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding HostVersion}" /></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Keyboard plugin -->
                <ScrollViewer Padding="42,34,34,50" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsKeyboardPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PluginWorkspace}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource KeyboardMouse}" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="720" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource KeyboardPageDescriptionRefined}" TextWrapping="Wrap" />

                        <Border Margin="0,24,0,0" Padding="22" Style="{StaticResource CardStyle}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{Binding KeyboardTest.StatusAccentBrush}" /><TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding KeyboardTest.StatusLabel}" /></StackPanel><TextBlock Margin="17,7,0,0" MaxWidth="650" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding KeyboardTest.StatusDescription}" TextWrapping="Wrap" /></StackPanel>
                                <Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding KeyboardTest.ToggleLabel}" IsEnabled="{Binding KeyboardTest.IsToggleEnabled}" Click="OnKeyboardTestToggleClick" Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,12,0,0" Visibility="{Binding AudioRelay.IsNormalToggleVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="KeyboardTestSurface" Grid.Column="0" Margin="0,0,6,0" Padding="22" MinHeight="230" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10" Focusable="True" KeyDown="OnKeyboardSurfaceKeyDown" KeyUp="OnKeyboardSurfaceKeyUp" MouseDown="OnKeyboardSurfaceMouseDown" MouseUp="OnKeyboardSurfaceMouseUp">
                                <StackPanel><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource InputSurface}" /><TextBlock Margin="0,14,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold" Text="{Binding KeyboardTest.LastInputLabel}" TextWrapping="Wrap" /><TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource InputSurfaceDescription}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <Border Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource KeyEvents}" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding KeyboardTest.KeyEventCountLabel}" /></StackPanel></Border>
                                <Border Margin="0,12,0,0" Padding="17" Style="{StaticResource CardStyle}"><StackPanel><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource MouseEvents}" /><TextBlock Margin="0,7,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding KeyboardTest.MouseEventCountLabel}" /></StackPanel></Border>
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,12,0,0" Padding="19" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><CheckBox Grid.Column="0" VerticalAlignment="Center" Content="{DynamicResource CountKeyUp}" IsChecked="{Binding KeyboardTest.IncludeKeyUpEvents}" IsEnabled="{Binding KeyboardTest.IsSettingsEnabled}" /><CheckBox Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Content="{DynamicResource CountMouse}" IsChecked="{Binding KeyboardTest.IncludeMouseEvents}" IsEnabled="{Binding KeyboardTest.IsSettingsEnabled}" /><Button Grid.Column="2" Content="{DynamicResource ApplySettings}" IsEnabled="{Binding KeyboardTest.IsSettingsEnabled}" Click="OnKeyboardTestApplySettingsClick" Style="{StaticResource QuietButtonStyle}" /></Grid></Border>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource RedBrush}" Text="{Binding KeyboardTest.ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding KeyboardTest.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Audio relay plugin -->
                <ScrollViewer Padding="42,34,34,50" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsAudioRelayPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PluginWorkspace}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource PhoneAudioRelay}" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="720" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource AudioPageDescriptionRefined}" TextWrapping="Wrap" />

                        <Border Margin="0,24,0,0" Padding="22" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{Binding AudioRelay.StatusAccentBrush}" /><TextBlock Style="{StaticResource SectionTitleText}" Text="{Binding AudioRelay.StatusLabel}" /></StackPanel><TextBlock Margin="17,7,0,0" MaxWidth="650" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AudioRelay.StatusDescription}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding AudioRelay.ToggleLabel}" IsEnabled="{Binding AudioRelay.IsToggleEnabled}" Visibility="{Binding AudioRelay.IsNormalToggleVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnAudioRelayToggleClick" Style="{StaticResource AccentButtonStyle}" /><Button Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center" Content="{Binding AudioRelay.RestartActionLabel}" IsEnabled="{Binding AudioRelay.IsRestartActionEnabled}" Visibility="{Binding AudioRelay.IsRestartActionVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Click="OnAudioRelayRestartClick" Style="{StaticResource AccentButtonStyle}" /></Grid></Border>

                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,6,0" Padding="22" Style="{StaticResource CardStyle}">
                                <StackPanel><TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource PairedPhones}" /><TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="{Binding AudioRelay.DeviceCountLabel}" /><ComboBox Margin="0,17,0,0" ItemsSource="{Binding AudioRelay.Devices}" SelectedItem="{Binding AudioRelay.SelectedDevice}" DisplayMemberPath="Name" Style="{StaticResource RelayComboBoxStyle}" /><StackPanel Margin="0,16,0,0" Orientation="Horizontal"><Button Content="{DynamicResource RefreshDevices}" IsEnabled="{Binding AudioRelay.IsRefreshEnabled}" Click="OnAudioRelayRefreshClick" Style="{StaticResource QuietButtonStyle}" /><Button Margin="8,0,0,0" Content="{DynamicResource StartReceiving}" IsEnabled="{Binding AudioRelay.IsConnectEnabled}" Click="OnAudioRelayConnectClick" Style="{StaticResource AccentButtonStyle}" /><Button Margin="8,0,0,0" Content="{DynamicResource StopReceiving}" IsEnabled="{Binding AudioRelay.IsDisconnectEnabled}" Click="OnAudioRelayDisconnectClick" Style="{StaticResource QuietButtonStyle}" /></StackPanel></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Margin="6,0,0,0" Padding="20" Style="{StaticResource CardStyle}"><StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource RelayRoute}" /><TextBlock Margin="0,18,0,0" FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource SelectedPhone}" /><TextBlock Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding AudioRelay.SelectedPhoneLabel}" TextWrapping="Wrap" /><Border Margin="0,13,0,13" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" /><TextBlock FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{DynamicResource RouteState}" /><TextBlock Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding AudioRelay.RouteStateLabel}" /></StackPanel></Border>
                        </Grid>
                        <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource RedBrush}" Text="{Binding AudioRelay.ErrorMessage}" TextWrapping="Wrap" Visibility="{Binding AudioRelay.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer Padding="42,34,34,58" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="1000">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="{DynamicResource HostSettings}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource PageTitleText}" Text="{DynamicResource Settings}" />
                        <TextBlock Margin="0,8,0,0" MaxWidth="760" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource SettingsDescriptionRefined}" TextWrapping="Wrap" />

                        <Border Margin="0,24,0,0" Style="{StaticResource CardStyle}"><Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource Language}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource LanguageDescription}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="中文" Click="OnSetChineseClick" Style="{StaticResource QuietButtonStyle}" /><Button Margin="7,0,0,0" Content="English" Click="OnSetEnglishClick" Style="{StaticResource QuietButtonStyle}" /></StackPanel></Grid></Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel Margin="18,15,18,10"><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource CloseBehaviorTitle}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource CloseBehaviorDescription}" /></StackPanel>
                                <Grid Margin="18,0,18,17"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Margin="0,0,5,0" Click="OnSetTrayCloseBehaviorClick" HorizontalContentAlignment="Stretch">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="Padding" Value="14" /><Style.Triggers><DataTrigger Binding="{Binding CloseToTray}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="BorderBrush" Value="#8BACEB" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" VerticalAlignment="Top" Stroke="{StaticResource BlueBrush}" StrokeThickness="1.5"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="White" /><Style.Triggers><DataTrigger Binding="{Binding CloseToTray}" Value="True"><Setter Property="Fill" Value="{StaticResource BlueBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><StackPanel Grid.Column="1"><TextBlock FontSize="11" FontWeight="SemiBold" Text="{DynamicResource MinimizeToTrayOption}" /><TextBlock Margin="0,4,0,0" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource MinimizeToTrayDescription}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Button>
                                    <Button Grid.Column="1" Margin="5,0,0,0" Click="OnSetExitCloseBehaviorClick" HorizontalContentAlignment="Stretch">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}"><Setter Property="Padding" Value="14" /><Style.Triggers><DataTrigger Binding="{Binding CloseDirectly}" Value="True"><Setter Property="Background" Value="{StaticResource SurfaceBlueBrush}" /><Setter Property="BorderBrush" Value="#8BACEB" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions><Ellipse Width="16" Height="16" VerticalAlignment="Top" Stroke="{StaticResource BlueBrush}" StrokeThickness="1.5"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="White" /><Style.Triggers><DataTrigger Binding="{Binding CloseDirectly}" Value="True"><Setter Property="Fill" Value="{StaticResource BlueBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><StackPanel Grid.Column="1"><TextBlock FontSize="11" FontWeight="SemiBold" Text="{DynamicResource ExitDirectlyOption}" /><TextBlock Margin="0,4,0,0" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource ExitDirectlyDescription}" TextWrapping="Wrap" /></StackPanel></Grid>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource PluginManagement}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding PluginCountSummaryLabel}" /></StackPanel><Button Grid.Column="1" VerticalAlignment="Center" Content="{DynamicResource InstallPlugin}" Click="OnInstallPluginClick" Style="{StaticResource AccentButtonStyle}" /></Grid>

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Visibility="{Binding IsKeyboardInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="18,13"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="{StaticResource SurfaceBlueBrush}" CornerRadius="8"><Path Width="17" Height="14" Data="M 1,3 L 19,3 L 19,15 L 1,15 Z M 5,7 L 5.1,7 M 8,7 L 8.1,7 M 11,7 L 11.1,7 M 14,7 L 14.1,7 M 6,11 L 14,11" Stroke="{StaticResource BlueBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="11" FontWeight="SemiBold" Text="{DynamicResource KeyboardMouse}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{StaticResource FaintTextBrush}"><Run Text="v" /><Run Text="{Binding KeyboardTest.InstalledVersion, Mode=OneWay}" /></TextBlock></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Text="{Binding KeyboardOpenedStateLabel}" /><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource InstallUpdate}" IsEnabled="{Binding KeyboardTest.IsInstallEnabled}" Click="OnKeyboardTestInstallClick" Style="{StaticResource QuietButtonStyle}" /><ToggleButton Margin="11,0" IsChecked="{Binding IsKeyboardOpened, Mode=OneWay}" IsEnabled="{Binding KeyboardTest.IsInstalled}" Click="OnKeyboardOpenedToggleClick" Style="{StaticResource SwitchStyle}" /><Button Content="{DynamicResource Uninstall}" IsEnabled="{Binding KeyboardTest.IsUninstallEnabled}" Click="OnKeyboardUninstallClick" Style="{StaticResource DangerButtonStyle}" /></StackPanel></Grid></Border>

                                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Visibility="{Binding IsAudioRelayInstalled, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid Margin="18,13"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="{StaticResource SurfaceBlueBrush}" CornerRadius="8"><Path Width="17" Height="17" Data="M 6,15 L 6,5 L 15,3 L 15,13 M 6,15 C 6,17 2,17 2,15 C 2,13 6,13 6,15 M 15,13 C 15,15 11,15 11,13 C 11,11 15,11 15,13" Stroke="{StaticResource BlueBrush}" StrokeThickness="1.4" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock FontSize="11" FontWeight="SemiBold" Text="{DynamicResource PhoneAudioRelay}" /><TextBlock Margin="0,3,0,0" FontSize="9" Foreground="{StaticResource FaintTextBrush}"><Run Text="v" /><Run Text="{Binding AudioRelay.InstalledVersion, Mode=OneWay}" /></TextBlock></StackPanel><TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MintBrush}" Text="{Binding AudioRelayOpenedStateLabel}" /><StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource InstallUpdate}" IsEnabled="{Binding AudioRelay.IsInstallEnabled}" Click="OnAudioRelayInstallClick" Style="{StaticResource QuietButtonStyle}" /><ToggleButton Margin="11,0" IsChecked="{Binding IsAudioRelayOpened, Mode=OneWay}" IsEnabled="{Binding AudioRelay.IsInstalled}" Click="OnAudioRelayOpenedToggleClick" Style="{StaticResource SwitchStyle}" /><Button Content="{DynamicResource Uninstall}" IsEnabled="{Binding AudioRelay.IsUninstallEnabled}" Click="OnAudioRelayUninstallClick" Style="{StaticResource DangerButtonStyle}" /></StackPanel></Grid></Border>

                                <StackPanel Margin="18,18,18,20" Visibility="{Binding HasNoInstalledPlugins, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock HorizontalAlignment="Center" Style="{StaticResource SectionTitleText}" Text="{DynamicResource NoPluginsInstalled}" /><TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource NoPluginsDescription}" /></StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Margin="0,9,0,0" FontSize="10" Foreground="{StaticResource RedBrush}" Text="{Binding PluginManagerError}" TextWrapping="Wrap" Visibility="{Binding HasPluginManagerError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Margin="0,12,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel><Grid Margin="18,15"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Style="{StaticResource SectionTitleText}" Text="{DynamicResource EventStreamTitle}" /><TextBlock Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{DynamicResource LogsDescription}" /></StackPanel><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource FaintTextBrush}" Text="{Binding EventCountLabel}" /></Grid><Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0"><ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding RecentEvents}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="75" /><ColumnDefinition Width="58" /><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontFamily="{StaticResource UtilityFont}" FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="{Binding TimestampText}" /><TextBlock Grid.Column="1" FontFamily="{StaticResource UtilityFont}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding LevelBrush}" Text="{Binding LevelText}" /><TextBlock Grid.Column="2" FontFamily="{StaticResource UtilityFont}" FontSize="9" Foreground="{StaticResource BlueDeepBrush}" Text="{Binding Module}" /><TextBlock Grid.Column="3" FontFamily="{StaticResource UtilityFont}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border></StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
