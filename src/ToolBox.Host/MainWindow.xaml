<Window x:Class="ToolBox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToolBox Host"
        Width="1160"
        Height="680"
        MinWidth="980"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource CanvasBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Border Background="{StaticResource CanvasBrush}"
            BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="9,9,0,0"
                    MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="126" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="20,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource DisplayFont}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="TOOLBOX" />
                        <TextBlock Margin="10,1,0,0"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AmberBrush}"
                                   Text="HOST SHELL" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button AutomationProperties.Name="Minimize window"
                                Click="OnMinimizeClick"
                                Content="—"
                                Style="{StaticResource ChromeButtonStyle}" />
                        <Button AutomationProperties.Name="Maximize window"
                                Click="OnMaximizeClick"
                                Content="□"
                                Style="{StaticResource ChromeButtonStyle}" />
                        <Button AutomationProperties.Name="Close window"
                                Click="OnCloseClick"
                                Content="×"
                                Style="{StaticResource ChromeButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="{StaticResource RailBrush}"
                    CornerRadius="0,0,0,9"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,28,18,18">
                        <TextBlock Style="{StaticResource EyebrowText}" Text="CONTROL DESK" />
                        <TextBlock Margin="0,7,0,24"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   Text="Host" />

                        <Button Content="Overview" IsEnabled="False" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="Keyboard &amp; Mouse" IsEnabled="False" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="Phone Audio Relay" IsEnabled="False" Style="{StaticResource NavButtonStyle}" />
                        <Button Content="Diagnostics" Style="{StaticResource NavButtonStyle}" />

                        <Border Margin="0,22,0,22" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" />

                        <TextBlock Style="{StaticResource EyebrowText}" Text="HOST CONTRACT" />
                        <TextBlock Margin="0,12,0,0"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                    Text="InProcess products active"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,5,0,0"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                    Text="Local input + Bluetooth audio"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="18,0,18,20" Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontFamily="{StaticResource BodyFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="CURRENT BUILD" />
                            <TextBlock Margin="0,5,0,0"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18"
                                       Foreground="{StaticResource AmberBrush}"
                                        Text="v0.1 / 2 PRODUCTS" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          Grid.Column="1"
                          Padding="42,32,42,36"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="930">
                    <TextBlock Style="{StaticResource EyebrowText}" Text="PRODUCT WORKBENCH / INPUT &amp; AUDIO" />
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="38"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                                Text="Connected Device Lab" />
                    <TextBlock Margin="0,8,0,0"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="14"
                               Foreground="{StaticResource MutedTextBrush}"
                                Text="Operate installable input and Bluetooth audio products with lifecycle, device, and resource state kept visible."
                               TextWrapping="Wrap" />

                    <Border Margin="0,28,0,0"
                            Padding="22"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="270" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="HOST STATUS" />
                                <StackPanel Margin="0,13,0,0" Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Margin="0,0,9,0" Fill="{Binding StatusAccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock FontFamily="{StaticResource DisplayFont}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="{Binding StatusLabel}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0"
                                           MaxWidth="520"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="13"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding StatusDescription}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="32,0,0,0">
                                <TextBlock Style="{StaticResource EyebrowText}" Text="LAUNCH ATTEMPT" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding LaunchAttemptId}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,16,0,0"
                                           Style="{StaticResource EyebrowText}"
                                           Text="LAST TRANSITION" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding UpdatedText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="16" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="SESSION" />
                                <TextBlock Margin="0,9,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding SessionId}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="8,0" Padding="16" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="STAGE" />
                                <TextBlock Margin="0,9,0,0"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding StageLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="8,0,0,0" Padding="16" Background="{StaticResource SurfaceBrush}" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="HOST VERSION" />
                                <TextBlock Margin="0,9,0,0"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="18"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="{Binding HostVersion}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="0.85*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Padding="20"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowText}" Text="PRODUCT PLUGIN" />
                                    <TextBlock Margin="0,7,0,0"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="23"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Text="Keyboard &amp; Mouse" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9"
                                                 Height="9"
                                                 Margin="0,0,8,0"
                                                 Fill="{Binding KeyboardTest.StatusAccentBrush}"
                                                 VerticalAlignment="Center" />
                                        <TextBlock FontFamily="{StaticResource BodyFont}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding KeyboardTest.StatusLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding KeyboardTest.PackageActionLabel}"
                                                IsEnabled="{Binding KeyboardTest.IsInstallEnabled}"
                                                Click="OnKeyboardTestInstallClick"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource QuietButtonStyle}" />
                                        <Button Content="{Binding KeyboardTest.ToggleLabel}"
                                                IsEnabled="{Binding KeyboardTest.IsToggleEnabled}"
                                                Click="OnKeyboardTestToggleClick"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border x:Name="KeyboardTestSurface"
                                        Grid.Row="2"
                                        Margin="0,18,0,0"
                                        Padding="16"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource AmberBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Focusable="True"
                                        PreviewKeyDown="OnKeyboardSurfaceKeyDown"
                                        PreviewKeyUp="OnKeyboardSurfaceKeyUp"
                                        PreviewMouseDown="OnKeyboardSurfaceMouseDown"
                                        PreviewMouseUp="OnKeyboardSurfaceMouseUp">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="INPUT SURFACE" />
                                        <WrapPanel Margin="0,13,0,0">
                                            <Border Width="44" Height="34" Margin="0,0,6,0" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="ESC" />
                                            </Border>
                                            <Border Width="44" Height="34" Margin="0,0,6,0" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10" Foreground="{StaticResource TextBrush}" Text="A" />
                                            </Border>
                                            <Border Width="44" Height="34" Margin="0,0,6,0" Background="{StaticResource SurfaceBrush}" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10" Foreground="{StaticResource TextBrush}" Text="SPACE" />
                                            </Border>
                                            <Border Width="44" Height="34" Background="{StaticResource AmberBrush}" CornerRadius="5">
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource CanvasBrush}" Text="ENTER" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Margin="0,14,0,0"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="16"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding KeyboardTest.LastInputLabel}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Grid Margin="0,13,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource EyebrowText}" Text="KEY EVENTS" />
                                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource TextBrush}" Text="{Binding KeyboardTest.KeyEventCountLabel}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Style="{StaticResource EyebrowText}" Text="MOUSE EVENTS" />
                                                <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="18" Foreground="{StaticResource TextBrush}" Text="{Binding KeyboardTest.MouseEventCountLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Row="3"
                                           Margin="0,12,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding KeyboardTest.StatusDescription}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Margin="12,0,0,0"
                                Padding="20"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EyebrowText}" Text="TEST SETTINGS" />
                                <TextBlock Margin="0,7,0,0"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}"
                                           Text="Change the signal rules" />
                                <TextBlock Margin="0,7,0,15"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="Choose which local signals to count, then apply the rule to the active plugin."
                                           TextWrapping="Wrap" />
                                <CheckBox Margin="0,0,0,10"
                                          FontFamily="{StaticResource BodyFont}"
                                          FontSize="12"
                                          Foreground="{StaticResource TextBrush}"
                                          IsChecked="{Binding KeyboardTest.IncludeKeyUpEvents, Mode=TwoWay}"
                                          Content="Count key-up signals" />
                                <CheckBox Margin="0,0,0,16"
                                          FontFamily="{StaticResource BodyFont}"
                                          FontSize="12"
                                          Foreground="{StaticResource TextBrush}"
                                          IsChecked="{Binding KeyboardTest.IncludeMouseEvents, Mode=TwoWay}"
                                          Content="Count mouse signals" />
                                <Button Content="Apply settings"
                                        IsEnabled="{Binding KeyboardTest.IsSettingsEnabled}"
                                        Click="OnKeyboardTestApplySettingsClick"
                                        Style="{StaticResource AccentButtonStyle}" />
                                <Border Margin="0,18,0,0" Padding="12" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="ACTIVE SETTINGS" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="{Binding KeyboardTest.SettingsSummary}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Margin="0,14,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource RedBrush}"
                                           Text="{Binding KeyboardTest.ErrorMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding KeyboardTest.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,34,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="PRODUCT 02 / BLUETOOTH AUDIO" />
                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="25"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="Phone Audio Relay" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,2,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding AudioRelay.StatusAccentBrush}" />
                            <TextBlock FontFamily="{StaticResource BodyFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="{Binding AudioRelay.StatusLabel}" />
                        </StackPanel>
                    </Grid>

                    <Border Padding="22"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="0.8*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource EyebrowText}" Text="A2DP SINK ROUTE" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontFamily="{StaticResource BodyFont}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding AudioRelay.DeviceCountLabel}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding AudioRelay.PackageActionLabel}"
                                                IsEnabled="{Binding AudioRelay.IsInstallEnabled}"
                                                Click="OnAudioRelayInstallClick"
                                                Margin="0,0,8,0"
                                                Style="{StaticResource QuietButtonStyle}" />
                                        <Button Content="{Binding AudioRelay.ToggleLabel}"
                                                IsEnabled="{Binding AudioRelay.IsToggleEnabled}"
                                                Click="OnAudioRelayToggleClick"
                                                Style="{StaticResource AccentButtonStyle}" />
                                    </StackPanel>
                                </Grid>

                                <Border Margin="0,18,0,0"
                                        Padding="16"
                                        Background="{StaticResource SurfaceRaisedBrush}"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="1.1*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource EyebrowText}" Text="PHONE" />
                                            <TextBlock Margin="0,5,0,0"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="15"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="{Binding AudioRelay.SelectedPhoneLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Height="1" Margin="8,0" Background="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Width="66" Height="42" Background="{StaticResource AmberBrush}" CornerRadius="21">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CanvasBrush}" Text="A2DP" />
                                                <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource CanvasBrush}" Text="{Binding AudioRelay.RouteStateLabel}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="3" Height="1" Margin="8,0" Background="{StaticResource AmberBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource EyebrowText}" Text="PC OUTPUT" />
                                            <TextBlock Margin="0,5,0,0"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="15"
                                                       Foreground="{StaticResource TextBrush}"
                                                       Text="WINDOWS MIX" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Margin="0,15,0,7"
                                           Style="{StaticResource EyebrowText}"
                                           Text="PAIRED AUDIO SOURCE" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox MinHeight="36"
                                              VerticalContentAlignment="Center"
                                              IsEnabled="{Binding AudioRelay.IsRefreshEnabled}"
                                              ItemsSource="{Binding AudioRelay.Devices}"
                                              SelectedItem="{Binding AudioRelay.SelectedDevice, Mode=TwoWay}"
                                              Style="{StaticResource RelayComboBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Content="Refresh paired phones"
                                            IsEnabled="{Binding AudioRelay.IsRefreshEnabled}"
                                            Click="OnAudioRelayRefreshClick"
                                            Style="{StaticResource QuietButtonStyle}" />
                                </Grid>

                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <Button Content="Start receiving"
                                            IsEnabled="{Binding AudioRelay.IsConnectEnabled}"
                                            Click="OnAudioRelayConnectClick"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <Button Margin="10,0,0,0"
                                            Content="Stop receiving"
                                            IsEnabled="{Binding AudioRelay.IsDisconnectEnabled}"
                                            Click="OnAudioRelayDisconnectClick"
                                            Style="{StaticResource QuietButtonStyle}" />
                                </StackPanel>

                                <TextBlock Margin="0,13,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding AudioRelay.StatusDescription}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource RedBrush}"
                                           Text="{Binding AudioRelay.ErrorMessage}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding AudioRelay.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Margin="18,0,0,0"
                                    Padding="17"
                                    Background="{StaticResource SurfaceRaisedBrush}"
                                    CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource EyebrowText}" Text="CONNECT SEQUENCE" />
                                    <TextBlock Margin="0,12,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource AmberBrush}" Text="01  PAIR" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="Pair the Android phone in Windows Bluetooth settings." TextWrapping="Wrap" />
                                    <TextBlock Margin="0,13,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource AmberBrush}" Text="02  DISCOVER" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="Enable the plugin and refresh the paired source list." TextWrapping="Wrap" />
                                    <TextBlock Margin="0,13,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="14" Foreground="{StaticResource AmberBrush}" Text="03  RECEIVE" />
                                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Text="Select the phone, start receiving, then play media on Android." TextWrapping="Wrap" />

                                    <Border Margin="0,17,0,0" Padding="12" Background="{StaticResource SurfaceBrush}" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource EyebrowText}" Text="PC AUDIO" />
                                            <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="15" Foreground="{StaticResource AmberBrush}" Text="REMAINS INTACT" />
                                            <TextBlock Margin="0,5,0,0" FontFamily="{StaticResource BodyFont}" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="The plugin adds the phone stream to the normal Windows output mix; it does not capture PC app audio." TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Margin="0,30,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource EyebrowText}" Text="EVENT STREAM" />
                            <TextBlock Margin="0,5,0,0"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22"
                                       Foreground="{StaticResource TextBrush}"
                                       Text="What the Host knows" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Margin="18,18,0,0"
                                   FontFamily="{StaticResource BodyFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding EventCount, StringFormat={}{0} captured}" />
                    </Grid>

                    <Border Padding="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="12">
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentEvents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="13,11" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="76" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock FontFamily="{StaticResource BodyFont}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding TimestampText}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="10,0,12,0"
                                                           FontFamily="{StaticResource BodyFont}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{Binding LevelBrush}"
                                                           Text="{Binding LevelText}" />
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock FontFamily="{StaticResource BodyFont}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AmberBrush}"
                                                               Text="{Binding Module}" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontFamily="{StaticResource BodyFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding Message}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Margin="0,16,0,0"
                               FontFamily="{StaticResource BodyFont}"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                                Text="Keyboard input stays local to the test surface. Phone Audio Relay receives Bluetooth media audio only and does not capture or replace PC application audio." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
