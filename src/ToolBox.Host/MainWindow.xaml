<Window x:Class="ToolBox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        Loaded="OnWindowLoaded"
        Unloaded="OnWindowUnloaded"
        StateChanged="OnWindowStateChanged"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome x:Name="Chrome" CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Padding" Value="12,8" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="all" /><Condition Binding="{Binding DataContext.PluginFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="all" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="running" /><Condition Binding="{Binding DataContext.PluginFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="running" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="disabled" /><Condition Binding="{Binding DataContext.PluginFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="disabled" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="attention" /><Condition Binding="{Binding DataContext.PluginFilter, RelativeSource={RelativeSource AncestorType=Window}}" Value="attention" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ChoiceButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Padding" Value="14,9" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="compact" /><Condition Binding="{Binding DataContext.DefaultPluginCardSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="compact" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="standard" /><Condition Binding="{Binding DataContext.DefaultPluginCardSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="standard" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="featured" /><Condition Binding="{Binding DataContext.DefaultPluginCardSize, RelativeSource={RelativeSource AncestorType=Window}}" Value="featured" /></MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ThemeChoiceStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" ClipToBounds="True">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.92" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.34" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="violet" /><Condition Binding="{Binding DataContext.Theme, RelativeSource={RelativeSource AncestorType=Window}}" Value="violet" /></MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="arctic" /><Condition Binding="{Binding DataContext.Theme, RelativeSource={RelativeSource AncestorType=Window}}" Value="arctic" /></MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="ember" /><Condition Binding="{Binding DataContext.Theme, RelativeSource={RelativeSource AncestorType=Window}}" Value="ember" /></MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions><Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="moss" /><Condition Binding="{Binding DataContext.Theme, RelativeSource={RelativeSource AncestorType=Window}}" Value="moss" /></MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PluginCardTemplate">
            <Border Margin="0,0,14,14" Padding="18" HorizontalAlignment="Stretch" Cursor="Hand" MouseLeftButtonUp="OnPluginCardMouseLeftButtonUp" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1" /></Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="MinHeight" Value="146" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStandardCard}" Value="True"><Setter Property="MinHeight" Value="188" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsFeaturedCard}" Value="True"><Setter Property="MinHeight" Value="236" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsAttention}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentStrongBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" Background="{DynamicResource AccentSoftBrush}" CornerRadius="11"><Path Width="18" Height="18" Data="{Binding IconGeometry}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center"><TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Publisher}" TextTrimming="CharacterEllipsis" /></StackPanel>
                        <Button Grid.Column="2" Width="30" Height="30" Padding="0" Tag="{Binding}" ToolTip="{DynamicResource More}" Click="OnPluginMoreClick" Style="{StaticResource IconButtonStyle}"><TextBlock FontSize="16" Text="···" /></Button>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,14,0,0" Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding LifecycleStateLabel}" /><TextBlock Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding RuntimeMode}" /></StackPanel>
                    <Grid Grid.Row="2" Margin="0,14,0,14" Visibility="{Binding IsStandardCard, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource InstalledVersionLabel}" /><TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding InstalledVersion}" /></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource RuntimeModeLabel}" /><TextBlock Margin="0,4,0,0" FontSize="12" Text="{Binding RuntimeDescription}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
                    <Border Grid.Row="2" Margin="0,14,0,14" Padding="12" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Opacity="0.9" Visibility="{Binding IsFeaturedCard, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding StatusDescription}" TextTrimming="CharacterEllipsis" /></Grid><ItemsControl Margin="0,11,0,0" ItemsSource="{Binding UiValues}" Visibility="{Binding HasUiValues, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,7,0" Padding="8,6" MinWidth="86" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock FontSize="9" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" /><TextBlock Margin="0,3,0,0" FontSize="11" FontWeight="SemiBold" Text="{Binding Value}" TextTrimming="CharacterEllipsis" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ErrorBrush}" Text="{Binding ErrorMessage}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Grid.Column="1" Margin="8,0,0,0" Content="{Binding RuntimeActionLabel}" IsEnabled="{Binding IsRuntimeActionEnabled}" Tag="{Binding}" Click="OnWorkspaceRuntimeToggleClick" Style="{StaticResource QuietButtonStyle}" /><Button Grid.Column="2" Margin="8,0,0,0" Content="{DynamicResource OpenDetails}" Tag="{Binding}" Click="OnPluginDetailsClick" Style="{StaticResource AccentButtonStyle}" /></Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RailPluginTemplate">
            <Button Tag="{Binding}" Click="OnPluginNavigationClick" Style="{StaticResource RailPluginButtonStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="22" Height="22" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7"><Path Width="12" Height="12" Data="{Binding IconGeometry}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1" /></Border><TextBlock Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /><Ellipse Grid.Column="2" Width="6" Height="6" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /></Grid></Button>
        </DataTemplate>

        <DataTemplate x:Key="EventRowTemplate">
            <Border Margin="0,0,0,8" Padding="12,11" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="9" /><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Margin="0,3,0,0" Fill="{Binding LevelBrush}" /><StackPanel Grid.Column="1"><TextBlock FontFamily="{StaticResource UtilityFont}" FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{Binding TimestampText}" /><TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" Text="{Binding Module}" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="12" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></Border>
        </DataTemplate>
    </Window.Resources>

<Border x:Name="WindowFrame" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineStrongBrush}" BorderThickness="1" ClipToBounds="True" Loaded="OnWindowFrameLoaded" SizeChanged="OnWindowFrameSizeChanged">
    <Border.Style><Style TargetType="Border"><Setter Property="CornerRadius" Value="{DynamicResource PanelCornerRadius}" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" /></DataTrigger></Style.Triggers></Style></Border.Style>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource RailBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid Margin="22,0,18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" Background="{DynamicResource AccentStrongBrush}" CornerRadius="11"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" Text="TB" /></Border>
                    <TextBlock Margin="11,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Text="ToolBox" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{DynamicResource Overview}" Tag="overview" Click="OnOverviewNavigationClick" Style="{StaticResource TopNavButtonStyle}"><StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,8,0" Data="M 2,2 L 8,2 L 8,8 L 2,8 Z M 12,2 L 18,2 L 18,8 L 12,8 Z M 2,12 L 8,12 L 8,18 L 12,18 Z M 12,12 L 18,12 L 18,18 L 12,18 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource Overview}" /></StackPanel></Button>
                    <Button AutomationProperties.Name="{DynamicResource NavPlugins}" Tag="plugins" Click="OnPluginsNavigationClick" Style="{StaticResource TopNavButtonStyle}"><StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,8,0" Data="M 3,4 L 17,4 L 17,17 L 3,17 Z M 6,1 L 14,1 L 14,4 M 6,8 L 14,8 M 6,12 L 11,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource NavPlugins}" /></StackPanel></Button>
                    <Button AutomationProperties.Name="{DynamicResource NavActivity}" Tag="activity" Click="OnActivityNavigationClick" Style="{StaticResource TopNavButtonStyle}"><StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,8,0" Data="M 1,10 L 5,10 L 7,4 L 11,16 L 14,9 L 19,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource NavActivity}" /></StackPanel></Button>
                    <Button AutomationProperties.Name="{DynamicResource Settings}" Tag="settings" Click="OnSettingsNavigationClick" Style="{StaticResource TopNavButtonStyle}"><StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,0,8,0" Data="M 10,2 L 11,4.5 A 6,6 0 0 1 13,5.5 L 15.5,4.5 L 17.5,6.5 L 16.5,9 A 6,6 0 0 1 16.5,11 L 17.5,13.5 L 15.5,15.5 L 13,14.5 A 6,6 0 0 1 11,15.5 L 10,18 L 7,18 L 6,15.5 A 6,6 0 0 1 4,14.5 L 1.5,15.5 L -0.5,13.5 L 0.5,11 A 6,6 0 0 1 0.5,9 L -0.5,6.5 L 1.5,4.5 L 4,5.5 A 6,6 0 0 1 6,4.5 L 7,2 Z M 10,7 A 3,3 0 1 0 10,13 A 3,3 0 1 0 10,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /><TextBlock Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Text="{DynamicResource Settings}" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><TextBlock FontSize="11" Text="{Binding StatusLabel}" /></StackPanel></Border>
                    <Button Margin="8,0,0,0" Content="{DynamicResource SyncStatus}" Click="OnRefreshStatusClick" Style="{StaticResource QuietButtonStyle}" />
                    <Button Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource Settings}" ToolTip="{DynamicResource Settings}" Click="OnSettingsNavigationClick" Style="{StaticResource IconButtonStyle}"><Path Width="16" Height="16" Data="M 10,2 L 11,4.5 A 6,6 0 0 1 13,5.5 L 15.5,4.5 L 17.5,6.5 L 16.5,9 A 6,6 0 0 1 16.5,11 L 17.5,13.5 L 15.5,15.5 L 13,14.5 A 6,6 0 0 1 11,15.5 L 10,18 L 7,18 L 6,15.5 A 6,6 0 0 1 4,14.5 L 1.5,15.5 L -0.5,13.5 L 0.5,11 A 6,6 0 0 1 0.5,9 L -0.5,6.5 L 1.5,4.5 L 4,5.5 A 6,6 0 0 1 6,4.5 L 7,2 Z M 10,7 A 3,3 0 1 0 10,13 A 3,3 0 1 0 10,7" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" /></Button>
                    <Button Margin="14,0,0,0" AutomationProperties.Name="{DynamicResource Minimize}" Click="OnMinimizeClick" Style="{StaticResource IconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="11" Data="M 1,7.5 L 10,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
                    <Button Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource Maximize}" Click="OnMaximizeClick" Style="{StaticResource IconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="11" Height="11" Data="M 1.5,1.5 L 9.5,1.5 L 9.5,9.5 L 1.5,9.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" /></Button>
                    <Button Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource Close}" Click="OnCloseClick" Style="{StaticResource IconButtonStyle}" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Path Width="11" Height="11" Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="PageHost" Grid.Row="1" RenderTransformOrigin="0.5,0.1">
            <Grid.RenderTransform><TranslateTransform x:Name="PageTranslate" /></Grid.RenderTransform>
            <Rectangle Fill="{DynamicResource CanvasDeepBrush}" />
            <Ellipse x:Name="GlowOne" Width="620" Height="480" Margin="-250,-220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource GlowOneBrush}" Opacity="0.72" IsHitTestVisible="False"><Ellipse.RenderTransform><TranslateTransform x:Name="GlowOneTransform" /></Ellipse.RenderTransform><Ellipse.Effect><BlurEffect Radius="120" /></Ellipse.Effect></Ellipse>
            <!-- 单一、低强度环境光，保持内容对比度。 -->
                                <ScrollViewer Padding="38,34,34,48" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" CanContentScroll="False" Visibility="{Binding IsOverviewPage, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel MaxWidth="1360" HorizontalAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Style="{StaticResource PageTitleText}" Text="{Binding OverviewTitle}" TextWrapping="Wrap" /><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{DynamicResource RefreshStatus}" Click="OnRefreshStatusClick" Style="{StaticResource QuietButtonStyle}" /><Button Margin="9,0,0,0" Content="{DynamicResource InstallPlugin}" Click="OnInstallPluginClick" Style="{StaticResource AccentButtonStyle}" /></StackPanel></Grid><Border Margin="0,24,0,0" Padding="14,13" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0" Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding StatusAccentBrush}" /><StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource SystemStatus}" /><TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding StatusLabel}" /></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="12,0" Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource HealthyBrush}" /><StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="Host" /><TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Running}" /></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="12,0" Orientation="Horizontal"><Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource HealthyBrush}" /><StackPanel><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="Worker" /><TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Running}" /></StackPanel></StackPanel><StackPanel Grid.Column="3" Margin="12,0,0,0"><TextBlock FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Text="{DynamicResource DataRetention}" /><TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding DataRetentionLabel}" /></StackPanel></Grid></Border><Border Margin="0,14,0,0" Padding="14,12" Style="{StaticResource CardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource Installed}" /><TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding InstalledPluginCount}" /></StackPanel><StackPanel Grid.Column="1"><TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource Running}" /><TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding RunningPluginCount}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource Attention}" /><TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}" Text="{Binding AttentionPluginCount}" /></StackPanel><StackPanel Grid.Column="3"><TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Text="{DynamicResource DataRetention}" /><TextBlock Margin="0,4,0,0" FontSize="24" FontWeight="SemiBold" Text="{Binding DataRetentionLabel}" /></StackPane