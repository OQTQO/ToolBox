{
  "formatVersion": 2,
  "id": "com.toolbox.hello",
  "name": "Hello Plugin",
  "version": "0.6.0",
  "pluginApiMajor": 1,
  "publisher": "toolbox.samples",
  "platform": {
    "os": "windows",
    "arch": "x64"
  },
  "runtime": {
    "supportedModes": [
      "outOfProcess"
    ],
    "preferredMode": "outOfProcess",
    "background": true
  },
  "capabilities": [{
    "id": "host.background.execution",
    "required": true,
    "reason": "Runs the sample plugin lifecycle in the background."
  }],
  "entryPoint": "HelloPlugin.HelloPlugin, HelloPlugin"
}
