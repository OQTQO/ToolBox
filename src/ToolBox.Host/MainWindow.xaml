                                                        Click="OnSetTrayCloseBehaviorClick"
                                                        Style="{StaticResource ChoiceButtonStyle}" />
                                                <Button Margin="8,0,0,0"
                                                         Tag="exit"
                                                         Content="{DynamicResource ExitDirectlyOption}"
                                                         AutomationProperties.Name="{DynamicResource ExitDirectlyOption}"
                                                         Click="OnSetExitCloseBehaviorClick"
                                                         Style="{StaticResource ChoiceButtonStyle}" />
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       FontWeight="Bold"
                                                       Text="{DynamicResource Language}" />
                                            <TextBlock Margin="0,4,0,11"
                                                       Style="{StaticResource MutedLabel}"
                                                       Text="{DynamicResource LanguageDescription}" />
