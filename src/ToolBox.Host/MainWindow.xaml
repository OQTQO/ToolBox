                                                             LostFocus="OnOverviewCopyLostFocus"
                                                             MaxLength="80"
                                                             TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,18,0,0">
                                                <Button Content="{DynamicResource ResetOverviewCopy}"
                                                        Click="OnResetOverviewCopyClick"
                                                        Style="{StaticResource QuietButtonStyle}" />
                                            </StackPanel>
                                            <Border Margin="0,18,0,0"
                                                    Padding="14"
                                                    Style="{StaticResource SoftSurfaceBorderStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Text="{DynamicResource ReduceMotion}" />
                                                        <TextBlock Margin="0,4,0,0"
                                                                   Style="{StaticResource MutedLabel}"
                                                                   Text="{DynamicResource ReduceMotionDescription}" />
                                                    </StackPanel>
                                                                    <ToggleButton Grid.Column="1"
                                                                  Tag="motion"
                                                                  IsChecked="{Binding ReduceMotion, Mode=OneWay}"
                                                                  AutomationProperties.Name="{DynamicResource ReduceMotion}"
                                                                  Click="OnAppearanceToggleClick"
                                                                  Style="{StaticResource SwitchStyle}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Orientation="Horizontal"
                                                        Margin="0,18,0,0">
                                                <StackPanel Width="220">
                                                    <TextBlock FontSize="12"
                                                               FontWeight="Bold"
                                                               Text="{DynamicResource BackgroundBrightness}" />
                                                    <Slider Margin="0,8,0,0"
                                                    Minimum="75"
                                                    Maximum="125"
                                                    Value="{Binding BackgroundBrightness, Mode=OneWay}"
